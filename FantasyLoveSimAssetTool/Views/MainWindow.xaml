                                                        Command="{Binding ReloadConversationCharacterPromptCommand}"
                                                        Padding="12,5" Margin="0,0,8,0"/>
                                                <Button Content="直前バックアップを復元"
                                                        Command="{Binding RestoreConversationCharacterPromptBackupCommand}"
                                                        Padding="12,5" Margin="0,0,8,0"/>
                                                <Button Content="固有プロンプトを保存"
                                                        Command="{Binding SaveConversationCharacterPromptCommand}"
                                                        Padding="12,5"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>

                            <Button Grid.Row="1" Content="保存" Command="{Binding SaveSelectedProfileCommand}" Width="120" Height="30" HorizontalAlignment="Right" Margin="0,12,0,0"/>
                        </Grid>
                    </TabItem>

                    <TabItem Header="会話データ">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

