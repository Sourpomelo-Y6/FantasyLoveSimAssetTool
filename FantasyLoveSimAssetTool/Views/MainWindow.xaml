                                                    <Button Content="複製" Command="{Binding DuplicateSkillTreeConditionCommand}" Width="70" Margin="8,0,0,0"/>
                                                    <Button Content="削除" Command="{Binding RemoveSkillTreeConditionCommand}" Width="70" Margin="8,0,0,0"/>
                                                </StackPanel>
                                                <DataGrid Grid.Row="1"
                                                          ItemsSource="{Binding SelectedProductionSkillTreeNode.UnlockConditions}"
                                                          SelectedItem="{Binding SelectedSkillTreeCondition}"
                                                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False">
                                                    <DataGrid.Columns>
                                                        <DataGridComboBoxColumn Header="条件種類"
                                                                                SelectedItemBinding="{Binding ConditionType, UpdateSourceTrigger=PropertyChanged}"
                                                                                ItemsSource="{Binding Data.SkillTreeConditionTypeOptions, Source={StaticResource ViewModelProxy}}"
                                                                                Width="180"/>
                                                        <DataGridTemplateColumn Header="範囲" Width="130">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate><TextBlock Text="{Binding Scope}" Padding="4,2"/></DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                                <DataTemplate>
                                                                    <ComboBox SelectedItem="{Binding Scope, UpdateSourceTrigger=PropertyChanged}"
                                                                              ItemsSource="{Binding ConditionType, Converter={StaticResource SkillConditionScopeOptionsConverter}}"/>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellEditingTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTemplateColumn Header="対象ID" Width="180">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate><TextBlock Text="{Binding TargetId}" Padding="4,2"/></DataTemplate>
