<Window x:Class="FantasyLoveSimAssetTool.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FantasyLoveSimAssetTool.ViewModels"
        xmlns:local="clr-namespace:FantasyLoveSimAssetTool.Views"
        mc:Ignorable="d"
        Title="FantasyLoveSimAssetTool" Height="980" Width="1500">
    <Window.Resources>
        <local:BindingProxy x:Key="ViewModelProxy" Data="{Binding}"/>
        <local:StringToImageSourceConverter x:Key="StringToImageSourceConverter"/>
        <local:EmptyStringToIntConverter x:Key="EmptyStringToIntConverter"/>
        <local:TrainingTargetOptionsConverter x:Key="TrainingTargetOptionsConverter"/>
        <local:SkillConditionScopeOptionsConverter x:Key="SkillConditionScopeOptionsConverter"/>
        <local:SkillConditionTargetOptionsConverter x:Key="SkillConditionTargetOptionsConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Window.DataContext>
        <vm:MainWindowModel/>
    </Window.DataContext>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right"
                    Content="保存先を変更"
                    Command="{Binding ChangeWorkspaceCommand}"
                    Padding="14,6"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right"
                    Content="LocalAI 接続設定"
                    Click="OpenLocalAiSettings_Click"
                    Padding="14,6"
                    Margin="12,0,0,0"
                    Background="#765D91"
                    Foreground="White"
                    VerticalAlignment="Center"/>
            <StackPanel>
                <TextBlock Text="FantasyLoveSimAssetTool" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding WorkspacePath, StringFormat=Workspace: {0}}" Foreground="Gray" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding WorkspaceWarning}" Foreground="#C06000" Margin="0,3,0,0"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="1" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="キャラクター" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <Border DockPanel.Dock="Top"
                            BorderBrush="#DDDDDD"
                            BorderThickness="1"
                            Padding="8"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="220"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Text="選択中のキャラクター画像"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <Grid Grid.Row="1" Background="#F7F7F7" ClipToBounds="True">
                                <Image Source="{Binding ProfilePreviewImagePath, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                       Stretch="Uniform"/>
                                <ItemsControl ItemsSource="{Binding ProfilePreviewItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Grid/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding ImagePath, Converter={StaticResource StringToImageSourceConverter}}"
                                                   Stretch="Uniform"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <TextBlock Grid.Row="2"
                                       Text="{Binding ProfilePreviewMessage}"
                                       Foreground="Gray"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                        </Grid>
                    </Border>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <TextBlock Text="HeroineId"/>
                        <TextBox Text="{Binding HeroineIdInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>

                        <TextBlock Text="表示名"/>
                        <TextBox Text="{Binding DisplayNameInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>

                        <Button Content="新規作成" Command="{Binding CreateCharacterCommand}" Height="28"/>
                        <Button Content="再読み込み" Command="{Binding RefreshProfilesCommand}" Height="28" Margin="0,8,0,0"/>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Profiles}"
                             SelectedItem="{Binding SelectedProfile}"
                             DisplayMemberPath="DisplayName"/>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" BorderBrush="#DDDDDD" BorderThickness="1" Padding="12">
                <TabControl SelectedIndex="{Binding SelectedMainTabIndex, Mode=TwoWay}">
                    <TabItem Header="基本情報">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TabControl Grid.Row="0" Margin="0,0,0,4"
                                        SelectedIndex="{Binding SelectedBasicInfoTabIndex, Mode=TwoWay}">
                                <TabItem Header="プロフィール">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                                        <Grid Margin="12,12,18,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="HeroineId" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedProfile.HeroineId}" IsReadOnly="True" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="表示名" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedProfile.DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="年齢" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedProfile.Age, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="身長" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedProfile.Height, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="性格" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SelectedProfile.Personality, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="82" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="口調" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding SelectedProfile.SpeakingStyle, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="82" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="一人称" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding SelectedProfile.FirstPerson, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="二人称" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding SelectedProfile.SecondPerson, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="好きなもの" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding SelectedProfile.Likes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="72" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                    <TextBlock Grid.Row="9" Grid.Column="0" Text="苦手なもの" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding SelectedProfile.Dislikes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="72" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                    <TextBlock Grid.Row="10" Grid.Column="0" Text="容姿プロンプト" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding SelectedProfile.AppearancePrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="96" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                    <TextBlock Grid.Row="11" Grid.Column="0" Text="スチル共通prompt" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="11"
                                             Grid.Column="1"
                                             Text="{Binding SelectedProfile.StillCommonPositivePrompt, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             Height="76"
                                             TextWrapping="Wrap"
                                             Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="12" Grid.Column="0" Text="行動反応方針" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="12" Grid.Column="1" Text="{Binding SelectedProfile.ActionReactionPolicy, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="88" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                    <TextBlock Grid.Row="13" Grid.Column="0" Text="エンディング方針" VerticalAlignment="Top" Margin="0,4,8,0"/>
                                    <TextBox Grid.Row="13" Grid.Column="1" Text="{Binding SelectedProfile.EndingPolicy, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="88" TextWrapping="Wrap"/>

                                        </Grid>
                                    </ScrollViewer>
                                </TabItem>

                                <TabItem Header="ゲーム設定・台詞">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                                        <Grid Margin="12,12,18,18">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                    <Expander Grid.Row="18" Grid.Column="0" Grid.ColumnSpan="2"
                                              Header="Unity 共通台詞" IsExpanded="True" Margin="0,16,0,12">
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="初回台詞" Margin="0,4,8,8"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedProfile.InitialDialogueMessage, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                                            <TextBlock Grid.Row="1" Text="次の行動" Margin="0,4,8,8"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedProfile.NextActionPrompt, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                                            <TextBlock Grid.Row="2" Text="朝の挨拶" Margin="0,4,8,8"/>
                                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedProfile.MorningGreeting, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                                            <TextBlock Grid.Row="3" Text="夜の挨拶" Margin="0,4,8,12"/>
                                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedProfile.GoodNightGreeting, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                                            <TextBlock Grid.Row="4" Text="開始時fallback" Margin="0,4,8,12"/>
                                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SelectedProfile.GameStartFallbackMessage, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                                            <TextBlock Grid.Row="5" Text="開始後メッセージ" Margin="0,4,8,0"/>
                                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding SelectedProfile.GameStartFollowUpMessage, UpdateSourceTrigger=PropertyChanged}"/>
                                            <local:LocalAiShortTextPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                                                                         TargetGroup="Common" Margin="0,12,0,0"/>
                                        </Grid>
                                    </Expander>

                                    <Expander Grid.Row="19" Grid.Column="0" Grid.ColumnSpan="2"
                                              Header="Unity Resource Paths" IsExpanded="False" Margin="0,4,0,8">
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBox Text="{Binding SelectedProfile.ConversationResourcePath, UpdateSourceTrigger=PropertyChanged}" ToolTip="Conversation Resource Path" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding SelectedProfile.GameEventResourcePath, UpdateSourceTrigger=PropertyChanged}" ToolTip="Game Event Resource Path" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding SelectedProfile.ActionResourcePath, UpdateSourceTrigger=PropertyChanged}" ToolTip="Action Resource Path" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding SelectedProfile.ScheduledEventResourcePath, UpdateSourceTrigger=PropertyChanged}" ToolTip="Scheduled Event Resource Path" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding SelectedProfile.BattleResultEventResourcePath, UpdateSourceTrigger=PropertyChanged}" ToolTip="Battle Result Event Resource Path" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding SelectedProfile.SoloReturnReactionResourcePath, UpdateSourceTrigger=PropertyChanged}" ToolTip="Solo Return Reaction Resource Path" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding SelectedProfile.BattlePanelResultMessageResourcePath, UpdateSourceTrigger=PropertyChanged}" ToolTip="Battle Panel Result Message Resource Path" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding SelectedProfile.EndingResourcePath, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ending Resource Path"/>
                                        </StackPanel>
                                    </Expander>

                                        </Grid>
                                    </ScrollViewer>
                                </TabItem>

                                <TabItem Header="ヒロイン戦闘スキル">
                                    <Grid Margin="16">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock Text="戦闘で使用するヒロイン固有スキルを編集します。"
                                                       Foreground="#666666" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="追加" Command="{Binding AddBattleSkillCommand}" Width="70" Margin="8,0,0,0"/>
                                                <Button Content="複製" Command="{Binding DuplicateBattleSkillCommand}" Width="70" Margin="8,0,0,0"/>
                                                <Button Content="削除" Command="{Binding RemoveBattleSkillCommand}" Width="70" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <DataGrid Grid.Row="1"
                                                  ItemsSource="{Binding SelectedProfile.BattleSkills}"
                                                  SelectedItem="{Binding SelectedProductionBattleSkill}"
                                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                                  ToolTip="確率は0～100、期間は1以上、MP・威力・回数は0以上で入力します。">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="SkillId" Binding="{Binding SkillId}" Width="130"/>
                                                <DataGridTextColumn Header="表示名" Binding="{Binding DisplayName}" Width="130"/>
                                                <DataGridComboBoxColumn Header="効果"
                                                                        SelectedItemBinding="{Binding EffectType, UpdateSourceTrigger=PropertyChanged}"
                                                                        ItemsSource="{Binding Data.BattleSkillEffectTypeOptions, Source={StaticResource ViewModelProxy}}"
                                                                        Width="90"/>
                                                <DataGridComboBoxColumn Header="対象"
                                                                        SelectedItemBinding="{Binding Target, UpdateSourceTrigger=PropertyChanged}"
                                                                        ItemsSource="{Binding Data.BattleSkillTargetOptions, Source={StaticResource ViewModelProxy}}"
                                                                        Width="90"/>
                                                <DataGridTextColumn Header="MP" Binding="{Binding Cost}" Width="55"/>
                                                <DataGridTextColumn Header="威力" Binding="{Binding Power}" Width="55"/>
                                                <DataGridComboBoxColumn Header="能力"
                                                                        SelectedItemBinding="{Binding AffectedStat, UpdateSourceTrigger=PropertyChanged}"
                                                                        ItemsSource="{Binding Data.BattleSkillAffectedStatOptions, Source={StaticResource ViewModelProxy}}"
                                                                        Width="85"/>
                                                <DataGridTextColumn Header="期間" Binding="{Binding StatusDurationTurns}" Width="55"/>
                                                <DataGridTextColumn Header="確率" Binding="{Binding UseChancePercent}" Width="55"/>
                                                <DataGridTextColumn Header="優先" Binding="{Binding Priority}" Width="55"/>
                                                <DataGridTextColumn Header="回数" Binding="{Binding MaxUsesPerBattle}" Width="55"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <Expander Grid.Row="2" Header="AI文章作成" Margin="0,12,0,0" IsExpanded="False">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520" Padding="4,8,4,0">
                                                <local:LocalAiShortTextPanel TargetGroup="BattleSkill"/>
                                            </ScrollViewer>
                                        </Expander>
                                    </Grid>
                                </TabItem>

                                <TabItem Header="ヒロイン訓練スキル">
                                    <Grid Margin="16">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="訓練スキル" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="参照候補を更新" Command="{Binding RefreshSkillReferenceOptionsCommand}" Width="110" Margin="8,0,0,0"
                                                        ToolTip="訓練IDやスキルIDを編集した後、参照用の選択肢を更新します"/>
                                                <Button Content="追加" Command="{Binding AddTrainingSkillCommand}" Width="70" Margin="8,0,0,0"/>
                                                <Button Content="複製" Command="{Binding DuplicateTrainingSkillCommand}" Width="70" Margin="8,0,0,0"/>
                                                <Button Content="削除" Command="{Binding RemoveTrainingSkillCommand}" Width="70" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <DataGrid Grid.Row="1"
                                                  ItemsSource="{Binding SelectedProfile.HeroineSkillTree.TrainingSkills}"
                                                  SelectedItem="{Binding SelectedProductionTrainingSkill}"
                                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                                  MinHeight="140" Margin="0,0,0,14"
                                                  ToolTip="適用範囲がAllTrainingsの場合は対象IDを空にします。TrainingCategoryではカテゴリーID、TrainingではTrainingIdを指定します。">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="SkillId" Binding="{Binding SkillId}" Width="120"/>
                                                <DataGridTextColumn Header="表示名" Binding="{Binding DisplayName}" Width="120"/>
                                                <DataGridTextColumn Header="説明" Binding="{Binding Description}" Width="220"/>
                                                <DataGridTextColumn Header="主人公HP軽減" Binding="{Binding PlayerHpCostReduction}" Width="90"/>
                                                <DataGridTextColumn Header="ヒロインHP軽減" Binding="{Binding HeroineHpCostReduction}" Width="100"/>
                                                <DataGridTextColumn Header="好感度補正" Binding="{Binding AffectionRewardModifier}" Width="80"/>
                                                <DataGridTextColumn Header="熟練度補正" Binding="{Binding ProficiencyRewardModifier}" Width="80"/>
                                                <DataGridComboBoxColumn Header="適用範囲"
                                                                        SelectedItemBinding="{Binding ApplicationScope, UpdateSourceTrigger=PropertyChanged}"
                                                                        ItemsSource="{Binding Data.TrainingSkillApplicationScopeOptions, Source={StaticResource ViewModelProxy}}"
                                                                        Width="130"/>
                                                <DataGridTemplateColumn Header="対象ID" Width="150">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding ApplicationTargetId}" Padding="4,2"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                    <DataGridTemplateColumn.CellEditingTemplate>
                                                        <DataTemplate>
                                                            <ComboBox SelectedItem="{Binding ApplicationTargetId, UpdateSourceTrigger=PropertyChanged}"
                                                                      IsEditable="False">
                                                                <ComboBox.ItemsSource>
                                                                    <MultiBinding Converter="{StaticResource TrainingTargetOptionsConverter}">
                                                                        <Binding Path="ApplicationScope"/>
                                                                        <Binding Path="Data.TrainingCategoryIdOptions" Source="{StaticResource ViewModelProxy}"/>
                                                                        <Binding Path="Data.TrainingIdOptions" Source="{StaticResource ViewModelProxy}"/>
                                                                    </MultiBinding>
                                                                </ComboBox.ItemsSource>
                                                            </ComboBox>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <Expander Grid.Row="2" Header="AI文章作成" Margin="0,12,0,0" IsExpanded="False">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520" Padding="4,8,4,0">
                                                <local:LocalAiShortTextPanel TargetGroup="TrainingSkill"/>
                                            </ScrollViewer>
                                        </Expander>
                                    </Grid>
                                </TabItem>

                                <TabItem Header="ヒロインスキルツリー">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                    <Grid Margin="16">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="240"/>
                                            <RowDefinition Height="190"/>
                                            <RowDefinition Height="210"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                            <TextBlock Text="ヒロインスキルツリーノード（前提・解放訓練・条件の詳細はJSON往復でも保持されます）"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="追加" Command="{Binding AddSkillTreeNodeCommand}" Width="70" Margin="8,0,0,0"/>
                                                <Button Content="複製" Command="{Binding DuplicateSkillTreeNodeCommand}" Width="70" Margin="8,0,0,0"/>
                                                <Button Content="削除" Command="{Binding RemoveSkillTreeNodeCommand}" Width="70" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <DataGrid Grid.Row="1"
                                                  ItemsSource="{Binding SelectedProfile.HeroineSkillTree.Nodes}"
                                                  SelectedItem="{Binding SelectedProductionSkillTreeNode}"
                                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                                  MinHeight="140"
                                                  ToolTip="付与スキルと取得時イベントは登録済みIDから選択します。条件はType|Scope|Target|Valueをセミコロン区切りで入力します。">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="NodeId" Binding="{Binding NodeId}" Width="120"/>
                                                <DataGridTextColumn Header="表示名" Binding="{Binding DisplayName}" Width="120"/>
                                                <DataGridComboBoxColumn Header="訓練SkillId"
                                                                        SelectedItemBinding="{Binding TrainingSkillId, UpdateSourceTrigger=PropertyChanged}"
                                                                        ItemsSource="{Binding Data.TrainingSkillIdOptions, Source={StaticResource ViewModelProxy}}"
                                                                        Width="130"/>
                                                <DataGridComboBoxColumn Header="戦闘SkillId"
                                                                        SelectedItemBinding="{Binding GrantedHeroineSkillId, UpdateSourceTrigger=PropertyChanged}"
                                                                        ItemsSource="{Binding Data.BattleSkillIdOptions, Source={StaticResource ViewModelProxy}}"
                                                                        Width="130"/>
                                                <DataGridTextColumn Header="SP" Binding="{Binding SkillPointCost}" Width="45"/>
                                                <DataGridComboBoxColumn Header="取得時EventId"
