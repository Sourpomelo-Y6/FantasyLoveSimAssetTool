                                                <local:LocalAiShortTextPanel TargetGroup="SkillTreeNode"/>
                                            </ScrollViewer>
                                        </Expander>
                                    </Grid>
                                    </ScrollViewer>
                                </TabItem>

                                <TabItem Header="衣装メッセージ">
