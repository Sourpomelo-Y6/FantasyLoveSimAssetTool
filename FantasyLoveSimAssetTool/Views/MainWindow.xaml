<Window x:Class="FantasyLoveSimAssetTool.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FantasyLoveSimAssetTool.ViewModels"
        xmlns:local="clr-namespace:FantasyLoveSimAssetTool.Views"
        mc:Ignorable="d"
        Title="FantasyLoveSimAssetTool" Height="980" Width="1500">
    <Window.Resources>
        <local:BindingProxy x:Key="ViewModelProxy" Data="{Binding}"/>
        <local:StringToImageSourceConverter x:Key="StringToImageSourceConverter"/>
        <local:EmptyStringToIntConverter x:Key="EmptyStringToIntConverter"/>
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Window.DataContext>
        <vm:MainWindowModel/>
    </Window.DataContext>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="FantasyLoveSimAssetTool" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding WorkspacePath, StringFormat=Workspace: {0}}" Foreground="Gray" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="1" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="キャラクター" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <TextBlock Text="HeroineId"/>
                        <TextBox Text="{Binding HeroineIdInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>

                        <TextBlock Text="表示名"/>
                        <TextBox Text="{Binding DisplayNameInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>

                        <Button Content="新規作成" Command="{Binding CreateCharacterCommand}" Height="28"/>
                        <Button Content="再読み込み" Command="{Binding RefreshProfilesCommand}" Height="28" Margin="0,8,0,0"/>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Profiles}"
                             SelectedItem="{Binding SelectedProfile}"
                             DisplayMemberPath="DisplayName"/>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" BorderBrush="#DDDDDD" BorderThickness="1" Padding="12">
                <TabControl>
                    <TabItem Header="基本情報">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="260"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="HeroineId" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedProfile.HeroineId}" IsReadOnly="True" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="表示名" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedProfile.DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="年齢" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedProfile.Age, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="身長" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedProfile.Height, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="性格" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SelectedProfile.Personality, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="56" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="口調" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding SelectedProfile.SpeakingStyle, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="56" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="一人称" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding SelectedProfile.FirstPerson, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="二人称" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding SelectedProfile.SecondPerson, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="好きなもの" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding SelectedProfile.Likes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="56" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="9" Grid.Column="0" Text="苦手なもの" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding SelectedProfile.Dislikes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="56" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="10" Grid.Column="0" Text="容姿プロンプト" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding SelectedProfile.AppearancePrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="72" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="11" Grid.Column="0" Text="スチル共通prompt" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="11"
                                             Grid.Column="1"
                                             Text="{Binding SelectedProfile.StillCommonPositivePrompt, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             Height="56"
                                             TextWrapping="Wrap"
                                             Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="12" Grid.Column="0" Text="行動反応方針" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="12" Grid.Column="1" Text="{Binding SelectedProfile.ActionReactionPolicy, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="64" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="13" Grid.Column="0" Text="エンディング方針" VerticalAlignment="Top" Margin="0,4,8,0"/>
                                    <TextBox Grid.Row="13" Grid.Column="1" Text="{Binding SelectedProfile.EndingPolicy, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="64" TextWrapping="Wrap"/>

                                    <Border Grid.Row="0"
                                            Grid.Column="2"
                                            Grid.RowSpan="14"
                                            BorderBrush="#DDDDDD"
                                            BorderThickness="1"
                                            Padding="10"
                                            Margin="16,0,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0"
                                                       Text="キャラクター画像"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,8"/>

                                            <Grid Grid.Row="1"
                                                  Background="#F7F7F7"
                                                  MinHeight="360"
                                                  ClipToBounds="True">
                                                <Image Source="{Binding ProfilePreviewImagePath, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                                       Stretch="Uniform"/>
                                                <ItemsControl ItemsSource="{Binding ProfilePreviewItems}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Grid/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Image Source="{Binding ImagePath, Converter={StaticResource StringToImageSourceConverter}}"
                                                                   Stretch="Uniform"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>

                                            <TextBlock Grid.Row="2"
                                                       Text="{Binding ProfilePreviewMessage}"
                                                       Foreground="Gray"
                                                       TextWrapping="Wrap"
                                                       Margin="0,8,0,0"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </ScrollViewer>

                            <Button Grid.Row="1" Content="保存" Command="{Binding SaveSelectedProfileCommand}" Width="120" Height="30" HorizontalAlignment="Right" Margin="0,12,0,0"/>
                        </Grid>
                    </TabItem>

                    <TabItem Header="会話データ">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="データ種別" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding ConversationDataKinds}"
                                          SelectedItem="{Binding SelectedConversationDataKind}"
                                          Height="26"
                                          Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="2"
                                           Text="会話、イベント、行動反応、エンディング本文を profile.json に保存します。"
                                           Foreground="Gray"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="3"
                                        Content="追加"
                                        Command="{Binding AddConversationEntryCommand}"
                                        Height="26"
                                        Margin="0,0,8,0"/>
                                <Button Grid.Column="4"
                                        Content="削除"
                                        Command="{Binding RemoveConversationEntryCommand}"
                                        Height="26"/>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="検索" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Grid.Row="0"
                                                 Grid.Column="1"
                                                 Text="{Binding ConversationSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,8,0"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="カテゴリ" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox Grid.Row="0"
                                                  Grid.Column="3"
                                                  ItemsSource="{Binding ConversationCategoryFilters}"
                                                  SelectedItem="{Binding SelectedConversationCategoryFilter}"
                                                  Height="26"/>
                                        <CheckBox Grid.Row="1"
                                                  Grid.Column="0"
                                                  Grid.ColumnSpan="2"
                                                  Content="警告ありのみ"
                                                  IsChecked="{Binding ShowOnlyConversationWarnings}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,6,8,0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="画像" VerticalAlignment="Center" Margin="0,6,8,0"/>
                                        <ComboBox Grid.Row="1"
                                                  Grid.Column="3"
                                                  ItemsSource="{Binding ConversationImageFilters}"
                                                  SelectedItem="{Binding SelectedConversationImageFilter}"
                                                  Height="26"
                                                  Margin="0,6,0,0"/>
                                    </Grid>

                                    <DataGrid Grid.Row="1"
                                              ItemsSource="{Binding FilteredConversationEntries}"
                                              SelectedItem="{Binding SelectedConversationEntry}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="140"/>
                                            <DataGridTextColumn Header="タイトル" Binding="{Binding Title}" Width="180"/>
                                            <DataGridTextColumn Header="カテゴリ" Binding="{Binding Category}" Width="120"/>
                                            <DataGridTextColumn Header="優先度" Binding="{Binding Priority}" Width="70"/>
                                            <DataGridTextColumn Header="先頭行" Binding="{Binding FirstLinePreview}" Width="*" IsReadOnly="True"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>

                                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Id" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                        <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding SelectedConversationEntry.Id, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                                            <Button Grid.Column="1" Content="ID生成" Command="{Binding GenerateConversationIdCommand}" Height="26"/>
                                        </Grid>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="タイトル" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedConversationEntry.Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="カテゴリ" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                        <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding SelectedConversationEntry.Category, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding ConversationCategorySuggestions}"
                                                      SelectedItem="{Binding SelectedConversationCategorySuggestion}"
                                                      Height="26"
                                                      Margin="0,0,8,0"/>
                                            <Button Grid.Column="2" Content="反映" Command="{Binding ApplyConversationCategorySuggestionCommand}" Height="26"/>
                                            <Button Grid.Column="3"
                                                    Content="イベント雛形"
                                                    Command="{Binding ApplyConversationEventTemplateCommand}"
                                                    Height="26"
                                                    Margin="8,0,0,0"/>
                                        </Grid>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="場所" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedConversationEntry.Conditions.LocationId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="好感度" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBox Text="{Binding SelectedConversationEntry.Conditions.MinAffection, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                            <TextBlock Text=" -" VerticalAlignment="Center" Margin="8,0,8,0"/>
                                            <TextBox Text="{Binding SelectedConversationEntry.Conditions.MaxAffection, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                            <CheckBox Content="一度だけ"
                                                      IsChecked="{Binding SelectedConversationEntry.Conditions.Once}"
                                                      VerticalAlignment="Center"
                                                      Margin="24,0,0,0"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="天候/季節/時間" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBox Text="{Binding SelectedConversationEntry.Conditions.Weather, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,8,0"/>
                                            <TextBox Text="{Binding SelectedConversationEntry.Conditions.Season, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,8,0"/>
                                            <TextBox Text="{Binding SelectedConversationEntry.Conditions.TimeOfDay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                                            <ComboBox ItemsSource="{Binding ConversationWeatherSuggestions}"
                                                      SelectedItem="{Binding SelectedConversationWeatherSuggestion}"
                                                      Width="105"
                                                      Height="26"
                                                      Margin="16,0,8,0"/>
                                            <ComboBox ItemsSource="{Binding ConversationSeasonSuggestions}"
                                                      SelectedItem="{Binding SelectedConversationSeasonSuggestion}"
                                                      Width="105"
                                                      Height="26"
                                                      Margin="0,0,8,0"/>
                                            <ComboBox ItemsSource="{Binding ConversationTimeOfDaySuggestions}"
                                                      SelectedItem="{Binding SelectedConversationTimeOfDaySuggestion}"
                                                      Width="105"
                                                      Height="26"
                                                      Margin="0,0,8,0"/>
                                            <Button Content="候補反映" Command="{Binding ApplyConversationConditionSuggestionsCommand}" Height="26" Width="80"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="行動/必要Item" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBox Text="{Binding SelectedConversationEntry.Conditions.ActionId, UpdateSourceTrigger=PropertyChanged}" Width="180" Margin="0,0,8,0"/>
                                            <TextBox Text="{Binding SelectedConversationEntry.Conditions.RequiredItemId, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                                            <ComboBox ItemsSource="{Binding ConversationActionSuggestions}"
                                                      SelectedItem="{Binding SelectedConversationActionSuggestion}"
                                                      Width="140"
                                                      Height="26"
                                                      Margin="16,0,8,0"/>
                                            <ComboBox ItemsSource="{Binding ConversationLocationSuggestions}"
                                                      SelectedItem="{Binding SelectedConversationLocationSuggestion}"
                                                      Width="140"
                                                      Height="26"
                                                      Margin="0,0,8,0"/>
                                            <Button Content="候補反映" Command="{Binding ApplyConversationConditionSuggestionsCommand}" Height="26" Width="80"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="7" Grid.Column="0" Text="必要フラグ" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding SelectedConversationEntry.Conditions.RequiredFlagIdsText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="8" Grid.Column="0" Text="画像AssetId" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                        <Grid Grid.Row="8" Grid.Column="1" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding SelectedConversationEntry.ImageAssetIdsText, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True"
                                                     Height="48"
                                                     TextWrapping="Wrap"
                                                     Margin="0,0,8,0"/>
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding AcceptedAssets}"
                                                      SelectedItem="{Binding SelectedConversationImageAsset}"
                                                      DisplayMemberPath="AssetId"
                                                      Height="26"
                                                      Margin="0,0,8,0"/>
                                            <Button Grid.Column="2" Content="追加" Command="{Binding AddConversationImageAssetCommand}" Height="26" VerticalAlignment="Top"/>
                                        </Grid>

                                        <TextBlock Grid.Row="9" Grid.Column="0" Text="優先度" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                        <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding SelectedConversationEntry.Priority, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left" Margin="0,0,0,8"/>

                                        <Grid Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="台詞行" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,220,0">
                                                <ComboBox ItemsSource="{Binding ConversationExpressionSuggestions}"
                                                          SelectedItem="{Binding SelectedConversationExpressionSuggestion}"
                                                          Width="120"
                                                          Height="26"
                                                          Margin="0,0,8,0"/>
                                                <Button Content="表情反映" Command="{Binding ApplyConversationExpressionSuggestionCommand}" Height="26" Width="80"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="行追加" Command="{Binding AddConversationLineCommand}" Height="26" Margin="0,0,8,0"/>
                                            <Button Grid.Column="2" Content="行削除" Command="{Binding RemoveConversationLineCommand}" Height="26"/>
                                        </Grid>

                                        <DataGrid Grid.Row="11"
                                                  Grid.Column="0"
                                                  Grid.ColumnSpan="2"
                                                  ItemsSource="{Binding SelectedConversationEntry.Lines}"
                                                  SelectedItem="{Binding SelectedConversationLine}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  MinHeight="160"
                                                  Margin="0,0,0,8">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="話者" Binding="{Binding Speaker}" Width="100"/>
                                                <DataGridTextColumn Header="表情" Binding="{Binding Expression}" Width="100"/>
                                                <DataGridTextColumn Header="本文" Binding="{Binding Text}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <TextBlock Grid.Row="12" Grid.Column="0" Text="メモ" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                        <TextBox Grid.Row="12"
                                                 Grid.Column="1"
                                                 Text="{Binding SelectedConversationEntry.Memo, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True"
                                                 Height="72"
                                                 TextWrapping="Wrap"
                                                 Margin="0,0,0,8"/>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>

                            <Button Grid.Row="2"
                                    Content="会話データ保存"
                                    Command="{Binding SaveConversationDataCommand}"
                                    Width="140"
                                    Height="30"
                                    HorizontalAlignment="Right"
                                    Margin="0,12,0,0"/>
                        </Grid>
                    </TabItem>

                    <TabItem Header="画像">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="96"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="AssetId" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding AssetIdInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="元画像" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="1"
                                         Grid.Column="1"
                                         Text="{Binding ImageSourcePathInput, UpdateSourceTrigger=PropertyChanged}"
                                         AllowDrop="True"
                                         PreviewDragOver="ImageSourcePath_PreviewDragOver"
                                         Drop="ImageSourcePath_Drop"
                                         Margin="0,0,8,8"/>
                                <Button Grid.Row="1" Grid.Column="2" Content="参照" Command="{Binding BrowseImageCommand}" Height="26" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="用途" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding AssetUsages}" SelectedItem="{Binding SelectedAssetUsage}" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="状態" VerticalAlignment="Center"/>
                                <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding AssetStatuses}" SelectedItem="{Binding SelectedAssetStatus}" Margin="0,0,8,0"/>
                                <Button Grid.Row="3" Grid.Column="2" Content="画像登録" Command="{Binding AddImageAssetCommand}" Height="26"/>
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="登録済み画像" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Status" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{Binding AssetStatusFilters}"
                                              SelectedItem="{Binding SelectedAssetStatusFilter}"
                                              Height="24"/>
                                </Grid>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="プレビュー" FontWeight="SemiBold" Margin="0,0,0,8"/>

                                <DataGrid Grid.Row="1"
                                          Grid.Column="0"
                                          ItemsSource="{Binding FilteredAssets}"
                                          SelectedItem="{Binding SelectedAsset}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="AssetId" Binding="{Binding AssetId}" Width="140" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="用途" Binding="{Binding Usage}" Width="90" IsReadOnly="True"/>
                                        <DataGridComboBoxColumn Header="状態"
                                                                SelectedItemBinding="{Binding Status}"
                                                                ItemsSource="{Binding Data.AssetStatuses, Source={StaticResource ViewModelProxy}}"
                                                                Width="100"/>
                                        <DataGridTextColumn Header="ファイル名" Binding="{Binding FileName}" Width="160" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="保存先" Binding="{Binding StoredPath}" Width="*" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel Grid.Row="2"
                                            Grid.Column="0"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,8,0,0">
                                    <Button Content="登録解除"
                                            Command="{Binding UnregisterImageAssetCommand}"
                                            Width="100"
                                            Height="28"
                                            Margin="0,0,8,0"/>
                                    <Button Content="画像情報保存"
                                            Command="{Binding SaveImageAssetsCommand}"
                                            Width="140"
                                            Height="28"/>
                                </StackPanel>

                                <Border Grid.Row="1"
                                        Grid.Column="2"
                                        BorderBrush="#DDDDDD"
                                        BorderThickness="1"
                                        Padding="8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Image Grid.Row="0"
                                               Source="{Binding SelectedAssetImagePath, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                               Stretch="Uniform"/>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding SelectedAssetImageMessage}"
                                                   Foreground="Gray"
                                                   TextWrapping="Wrap"
                                                   Margin="0,8,0,0"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="スチル作業">
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    BorderBrush="#DDDDDD"
                                    BorderThickness="1"
                                    Padding="10">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top"
                                               Text="作成対象"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8"/>
                                    <TextBlock DockPanel.Dock="Top"
                                               Text="通常のスチル生成、登録、採用作業はこのタブで行います。"
                                               Foreground="Gray"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>

                                    <ComboBox DockPanel.Dock="Top"
                                              ItemsSource="{Binding StillUsageFilters}"
                                              SelectedItem="{Binding SelectedStillUsageFilter}"
                                              Margin="0,0,0,8"/>

                                    <ListBox ItemsSource="{Binding FilteredStillDefinitions}"
                                             SelectedItem="{Binding SelectedStillDefinition}"
                                             BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4,0,6">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Row="0"
                                                               Grid.Column="0"
                                                               Text="{Binding DisplayName}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Row="0"
                                                               Grid.Column="1"
                                                               Text="{Binding Status}"
                                                               Foreground="Gray"
                                                               Margin="8,0,0,0"/>
                                                    <TextBlock Grid.Row="1"
                                                               Grid.Column="0"
                                                               Grid.ColumnSpan="2"
                                                               Text="{Binding AssetId}"
                                                               Foreground="Gray"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Grid.ColumnSpan="4"
                                           Text="{Binding SelectedStillDefinition.DisplayName}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,12"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="AssetId" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedStillDefinition.AssetId}" IsReadOnly="True" Margin="0,0,12,8"/>

                                <TextBlock Grid.Row="1" Grid.Column="2" Text="状態" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <ComboBox Grid.Row="1"
                                          Grid.Column="3"
                                          ItemsSource="{Binding StillStatuses}"
                                          SelectedItem="{Binding SelectedStillDefinition.Status}"
                                          Margin="0,0,0,8"/>

                                <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="72"/>
                                        <RowDefinition Height="70"/>
                                        <RowDefinition Height="70"/>
                                        <RowDefinition Height="120"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="220"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="状況" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding SelectedStillImageStatusText}" Margin="0,0,16,0"/>
                                        <TextBlock Text="{Binding SelectedStillPromptStatusText}" Margin="0,0,16,0"/>
                                        <TextBlock Text="{Binding SelectedStillAssetStatusText}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="用途" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedStillDefinition.Usage}" IsReadOnly="True" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="出力ファイル" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedStillDefinition.FileName}" IsReadOnly="True" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="追加 prompt" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="3"
                                             Grid.Column="1"
                                             Text="{Binding SelectedStillDefinition.SpecificPrompt, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             Height="76"
                                             TextWrapping="Wrap"
                                             Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="negative prompt" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="4"
                                             Grid.Column="1"
                                             Text="{Binding CurrentPromptRecord.NegativePrompt, Mode=OneWay}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="negative 追加" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="5"
                                             Grid.Column="1"
                                             Text="{Binding SelectedStillDefinition.NegativePromptAddition, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Comfy 結果" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="6"
                                             Grid.Column="1"
                                             Text="{Binding CurrentComfyResultSummary, Mode=OneWay}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="合成 prompt" VerticalAlignment="Top" Margin="0,4,8,0"/>
                                    <TextBox Grid.Row="7"
                                             Grid.Column="1"
                                             Text="{Binding StillPromptPreview, Mode=OneWay}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="workflow preview" VerticalAlignment="Top" Margin="0,4,8,0"/>
                                    <TextBox Grid.Row="8"
                                             Grid.Column="1"
                                             Text="{Binding CurrentComfyWorkflowPreview, Mode=OneWay}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             HorizontalScrollBarVisibility="Auto"
                                             VerticalScrollBarVisibility="Auto"/>

                                    <Border Grid.Row="0"
                                            Grid.Column="3"
                                            Grid.RowSpan="9"
                                            BorderBrush="#DDDDDD"
                                            BorderThickness="1"
                                            Padding="8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="12"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Image Grid.Row="0"
                                                   Source="{Binding SelectedStillImagePath, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                                   Stretch="Uniform"/>
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding SelectedStillImageMessage}"
                                                       Foreground="Gray"
                                                       TextWrapping="Wrap"
                                                       Margin="0,8,0,0"/>
                                            <Image Grid.Row="3"
                                                   Source="{Binding CurrentComfyPreviewImagePath, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                                   Stretch="Uniform"/>
                                            <TextBlock Grid.Row="4"
                                                       Text="{Binding CurrentComfyPreviewImageMessage}"
                                                       Foreground="Gray"
                                                       TextWrapping="Wrap"
                                                       Margin="0,8,0,0"/>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <WrapPanel Grid.Row="3"
                                           Grid.Column="1"
                                           Grid.ColumnSpan="3"
                                           HorizontalAlignment="Right"
                                           Margin="0,12,0,0">
                                    <Button Content="画像登録欄に反映"
                                            Command="{Binding PrepareImageRegistrationForStillCommand}"
                                            Width="150"
                                            Height="30"
                                            Margin="0,0,8,8"/>
                                    <Button Content="Prompt に反映"
                                            Command="{Binding ApplyStillPromptCommand}"
                                            Width="140"
                                            Height="30"
                                            Margin="0,0,8,8"/>
                                    <Button Content="Comfy 作成"
                                            Command="{Binding BuildStillComfyWorkflowPreviewCommand}"
                                            Width="110"
                                            Height="30"
                                            Margin="0,0,8,8"/>
                                    <Button Content="Comfy 送信"
                                            Command="{Binding SubmitStillComfyPromptCommand}"
                                            Width="110"
                                            Height="30"
                                            Margin="0,0,8,8"/>
                                    <Button Content="待機キャンセル"
                                            Command="{Binding CancelStillComfyPollingCommand}"
                                            Width="110"
                                            Height="30"
                                            Margin="0,0,8,8"/>
                                    <Button Content="Comfy 停止"
                                            Command="{Binding InterruptComfyGenerationCommand}"
                                            Width="100"
                                            Height="30"
                                            Margin="0,0,8,8"/>
                                    <Button Content="結果確認"
                                            Command="{Binding CheckStillComfyResultCommand}"
                                            Width="90"
                                            Height="30"
                                            Margin="0,0,8,8"/>
                                    <Button Content="画像取得"
                                            Command="{Binding FetchStillComfyImageCommand}"
                                            Width="90"
                                            Height="30"
                                            Margin="0,0,8,8"/>
                                    <Button Content="Comfy 採用"
                                            Command="{Binding AdoptStillComfyImageCommand}"
                                            Width="100"
                                            Height="30"
                                            Margin="0,0,8,8"/>
                                    <Button Content="スチル保存"
                                            Command="{Binding SaveSelectedProfileCommand}"
                                            Width="110"
                                            Height="30"
                                            Margin="0,0,0,8"/>
                                </WrapPanel>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="差分定義">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="表情、衣装、透過レイヤー素材の共通定義を編集します。保存すると Definitions/*.json に反映され、スチル作業タブと Export に使われます。"
                                       Foreground="Gray"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>

                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                                        <TextBlock Text="表情定義" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                            <Button Content="追加"
                                                    Command="{Binding AddExpressionDefinitionCommand}"
                                                    Width="70"
                                                    Height="26"
                                                    Margin="8,0,0,0"/>
                                            <Button Content="削除"
                                                    Command="{Binding RemoveExpressionDefinitionCommand}"
                                                    Width="70"
                                                    Height="26"
                                                    Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <DataGrid Grid.Row="1"
                                              ItemsSource="{Binding ExpressionDefinitions}"
                                              SelectedItem="{Binding SelectedExpressionDefinition}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ExpressionId" Binding="{Binding ExpressionId, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                                            <DataGridTextColumn Header="表示名" Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                                            <DataGridTextColumn Header="Unity ID" Binding="{Binding UnityExpressionId, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                                            <DataGridTextColumn Header="Prompt" Binding="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>

                                <Grid Grid.Row="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                                        <TextBlock Text="衣装定義" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                            <Button Content="追加"
                                                    Command="{Binding AddCostumeDefinitionCommand}"
                                                    Width="70"
                                                    Height="26"
                                                    Margin="8,0,0,0"/>
                                            <Button Content="削除"
                                                    Command="{Binding RemoveCostumeDefinitionCommand}"
                                                    Width="70"
                                                    Height="26"
                                                    Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <DataGrid Grid.Row="1"
                                              ItemsSource="{Binding CostumeDefinitions}"
                                              SelectedItem="{Binding SelectedCostumeDefinition}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="CostumeId" Binding="{Binding CostumeId, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                                            <DataGridTextColumn Header="表示名" Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                                            <DataGridTextColumn Header="Unity ID" Binding="{Binding UnityCostumeId, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                                            <DataGridTextColumn Header="Prompt" Binding="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>

                                <Grid Grid.Row="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                                        <TextBlock Text="透過レイヤー素材定義" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                            <Button Content="追加"
                                                    Command="{Binding AddLayerAssetDefinitionCommand}"
                                                    Width="70"
                                                    Height="26"
                                                    Margin="8,0,0,0"/>
                                            <Button Content="削除"
                                                    Command="{Binding RemoveLayerAssetDefinitionCommand}"
                                                    Width="70"
                                                    Height="26"
                                                    Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <DataGrid Grid.Row="1"
                                              ItemsSource="{Binding LayerAssetDefinitions}"
                                              SelectedItem="{Binding SelectedLayerAssetDefinition}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="AssetId" Binding="{Binding AssetId, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                                            <DataGridComboBoxColumn Header="種類"
                                                                    SelectedItemBinding="{Binding LayerKind, UpdateSourceTrigger=PropertyChanged}"
                                                                    ItemsSource="{Binding Data.LayerKindOptions, Source={StaticResource ViewModelProxy}}"
                                                                    Width="110"/>
                                            <DataGridComboBoxColumn Header="衣装ID"
                                                                    SelectedItemBinding="{Binding CostumeId, UpdateSourceTrigger=PropertyChanged}"
                                                                    ItemsSource="{Binding Data.CostumeIdOptions, Source={StaticResource ViewModelProxy}}"
                                                                    Width="130"/>
                                            <DataGridComboBoxColumn Header="表情ID"
                                                                    SelectedItemBinding="{Binding ExpressionId, UpdateSourceTrigger=PropertyChanged}"
                                                                    ItemsSource="{Binding Data.ExpressionIdOptions, Source={StaticResource ViewModelProxy}}"
                                                                    Width="130"/>
                                            <DataGridTextColumn Header="表示名" Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                                            <DataGridTextColumn Header="ファイル名" Binding="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" Width="170"/>
                                            <DataGridTextColumn Header="描画順"
                                                                Binding="{Binding DrawOrder, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EmptyStringToIntConverter}}"
                                                                Width="80"/>
                                            <DataGridTextColumn Header="Prompt" Binding="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="252"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding DefinitionCatalogValidationMessage}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Height="64"
                                         Foreground="#B00020"
                                         BorderBrush="#E0B4B4"/>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                    <Button Content="再読み込み"
                                            Command="{Binding ReloadDefinitionCatalogCommand}"
                                            Width="120"
                                            Height="30"
                                            Margin="0,0,8,0"/>
                                    <Button Content="保存"
                                            Command="{Binding SaveDefinitionCatalogCommand}"
                                            Width="120"
                                            Height="30"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="レイヤープレビュー">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Accepted 済みの透過レイヤー素材を DrawOrder 順に重ねて確認します。BaseBody、Costume、Expression を選び、Unity に渡す前に位置ずれと描画順を確認します。"
                                       Foreground="Gray"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="360"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="1" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="組み合わせ" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                        <TextBlock Text="BaseBody"/>
                                        <ComboBox ItemsSource="{Binding LayerPreviewBaseBodyOptions}"
                                                  SelectedItem="{Binding SelectedLayerPreviewBaseBodyId}"
                                                  Height="26"
                                                  Margin="0,4,0,12"/>

                                        <TextBlock Text="Costume"/>
                                        <ComboBox ItemsSource="{Binding LayerPreviewCostumeOptions}"
                                                  SelectedItem="{Binding SelectedLayerPreviewCostumeId}"
                                                  Height="26"
                                                  Margin="0,4,0,12"/>

                                        <TextBlock Text="Expression"/>
                                        <ComboBox ItemsSource="{Binding LayerPreviewExpressionOptions}"
                                                  SelectedItem="{Binding SelectedLayerPreviewExpressionId}"
                                                  Height="26"
                                                  Margin="0,4,0,12"/>

                                        <Button Content="更新"
                                                Command="{Binding RefreshLayerPreviewCommand}"
                                                Height="30"
                                                Margin="0,4,0,12"/>

                                        <TextBlock Text="{Binding LayerPreviewMessage}"
                                                   Foreground="Gray"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        BorderBrush="#DDDDDD"
                                        BorderThickness="1"
                                        Padding="12">
                                    <Grid Background="#F7F7F7">
                                        <ItemsControl ItemsSource="{Binding LayerPreviewItems}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Grid/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Image Source="{Binding ImagePath, Converter={StaticResource StringToImageSourceConverter}}"
                                                           Stretch="Uniform"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="4" BorderBrush="#DDDDDD" BorderThickness="1" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="表示中レイヤー" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <DataGrid Grid.Row="1"
                                                  ItemsSource="{Binding LayerPreviewItems}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  CanUserAddRows="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="順" Binding="{Binding DrawOrder}" Width="50"/>
                                                <DataGridTextColumn Header="種類" Binding="{Binding LayerKind}" Width="90"/>
                                                <DataGridTextColumn Header="AssetId" Binding="{Binding AssetId}" Width="150"/>
                                                <DataGridTextColumn Header="表示名" Binding="{Binding DisplayName}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="スチル一覧(確認用)">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="仕様書で常に作成するスチル候補を表形式で確認するための画面です。通常の生成、登録、採用作業はスチル作業タブで行います。"
                                       Foreground="Gray"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>

                            <Button Grid.Row="1"
                                    Content="Prompt に反映"
                                    Command="{Binding ApplyStillPromptCommand}"
                                    Width="140"
                                    Height="28"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,0,8"/>

                            <DataGrid Grid.Row="2"
                                      ItemsSource="{Binding StillDefinitions}"
                                      SelectedItem="{Binding SelectedStillDefinition}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="AssetId" Binding="{Binding AssetId}" Width="150" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="用途" Binding="{Binding Usage}" Width="90" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="表示名" Binding="{Binding DisplayName}" Width="150" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="ファイル名" Binding="{Binding FileName}" Width="170" IsReadOnly="True"/>
                                    <DataGridTemplateColumn Header="状態" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Status}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding DataContext.StillStatuses, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding Status, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="SpecificPrompt"
                                                        Binding="{Binding SpecificPrompt, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="*"/>
                                    <DataGridTextColumn Header="NegativeAddition"
                                                        Binding="{Binding NegativePromptAddition, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="220"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Prompt">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="330"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Grid.ColumnSpan="3"
                                           Text="{Binding SelectedAsset.AssetId, StringFormat=選択中 Asset: {0}}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="テンプレート" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel Grid.Row="1"
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            Margin="0,0,8,0">
                                    <ComboBox ItemsSource="{Binding AssetUsages}"
                                              SelectedItem="{Binding SelectedPromptTemplateUsage}"
                                              Width="120"
                                              Margin="0,0,8,0"/>
                                    <ComboBox ItemsSource="{Binding AvailablePromptTemplates}"
                                              SelectedItem="{Binding SelectedPromptTemplate}"
                                              DisplayMemberPath="DisplayName"
                                              Width="320"/>
                                </StackPanel>
                                <Button Grid.Row="1" Grid.Column="2" Content="適用" Command="{Binding ApplyPromptTemplateCommand}" Height="26"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="ComfyUI" VerticalAlignment="Center" Margin="0,8,8,0"/>
                                <TextBox Grid.Row="2"
                                         Grid.Column="1"
                                         Text="{Binding ComfySettingsSummary}"
                                         IsReadOnly="True"
                                         Margin="0,8,8,0"/>
                                <StackPanel Grid.Row="2"
                                            Grid.Column="2"
                                            Orientation="Horizontal"
                                            Margin="0,8,0,0">
                                    <Button Content="設定再読込"
                                            Command="{Binding ReloadComfySettingsCommand}"
                                            Width="84"
                                            Height="26"
                                            Margin="0,0,4,0"/>
                                    <Button Content="作成"
                                            Command="{Binding BuildComfyWorkflowPreviewCommand}"
                                            Width="52"
                                            Height="26"
                                            Margin="0,0,4,0"/>
                                    <Button Content="テンプレ読込"
                                            Command="{Binding LoadComfyWorkflowTemplateCommand}"
                                            Width="84"
                                            Height="26"
                                            Margin="0,0,4,0"/>
                                    <Button Content="テンプレ保存"
                                            Command="{Binding SaveComfyWorkflowTemplateCommand}"
                                            Width="84"
                                            Height="26"/>
                                </StackPanel>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="positive prompt" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding CurrentPromptRecord.PositivePrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="86" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="negative prompt" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding CurrentPromptRecord.NegativePrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="model" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CurrentPromptRecord.Model, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,8"/>

                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="VAE" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding CurrentPromptRecord.Vae, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="LoRA" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CurrentPromptRecord.Lora, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,8"/>

                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="sampler" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding CurrentPromptRecord.Sampler, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="steps" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CurrentPromptRecord.Steps, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,8"/>

                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="CFG scale" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="4" Grid.Column="3" Text="{Binding CurrentPromptRecord.CfgScale, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="seed" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding CurrentPromptRecord.Seed, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,8"/>

                                    <TextBlock Grid.Row="5" Grid.Column="2" Text="image size" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <StackPanel Grid.Row="5" Grid.Column="3" Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBox Text="{Binding CurrentPromptRecord.ImageWidth, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                        <TextBlock Text=" x " VerticalAlignment="Center" Margin="6,0"/>
                                        <TextBox Text="{Binding CurrentPromptRecord.ImageHeight, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="ControlNet" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding CurrentPromptRecord.ControlNetMemo, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="48" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="upscale" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding CurrentPromptRecord.UpscaleMemo, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="48" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="inpaint / img2img" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding CurrentPromptRecord.InpaintMemo, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="48" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="9" Grid.Column="0" Text="採用理由" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding CurrentPromptRecord.AdoptionReason, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="56" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="10" Grid.Column="0" Text="修正メモ" VerticalAlignment="Top" Margin="0,4,8,0"/>
                                    <TextBox Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding CurrentPromptRecord.RevisionMemo, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="56" TextWrapping="Wrap"/>

                                    <TextBlock Grid.Row="11" Grid.Column="0" Text="Comfy workflow" VerticalAlignment="Top" Margin="0,12,8,0"/>
                                    <TextBox Grid.Row="11"
                                             Grid.Column="1"
                                             Grid.ColumnSpan="3"
                                             Text="{Binding CurrentComfyWorkflowPreview}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             Height="140"
                                             TextWrapping="NoWrap"
                                             HorizontalScrollBarVisibility="Auto"
                                             VerticalScrollBarVisibility="Auto"
                                             Margin="0,8,0,0"/>

                                    <TextBlock Grid.Row="12" Grid.Column="0" Text="workflow template" VerticalAlignment="Top" Margin="0,12,8,0"/>
                                    <TextBox Grid.Row="12"
                                             Grid.Column="1"
                                             Grid.ColumnSpan="3"
                                             Text="{Binding ComfyWorkflowTemplateEditorText, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             Height="220"
                                             TextWrapping="NoWrap"
                                             HorizontalScrollBarVisibility="Auto"
                                             VerticalScrollBarVisibility="Auto"
                                             Margin="0,8,0,0"/>
                                </Grid>
                            </ScrollViewer>

                            <Button Grid.Row="2" Content="Prompt 保存" Command="{Binding SavePromptRecordCommand}" Width="140" Height="30" HorizontalAlignment="Right" Margin="0,12,0,0"/>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Export">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="出力先" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ExportPath, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="2"
                                       Text="Accepted の画像、対応する prompt JSON、Data 下書き Markdown を Unity 取り込み用に出力します。"
                                       Foreground="Gray"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>

                            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding LastExportReport.AcceptedAssetCount, StringFormat=Accepted: {0}}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LastExportReport.ExportedImageCount, StringFormat=Images: {0}}"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding LastExportReport.ExportedPromptCount, StringFormat=Prompts: {0}}"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding LastExportReport.SkippedImageCount, StringFormat=Skipped: {0}}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding LastExportReport.ConversationCount, StringFormat=Conversations: {0}}" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LastExportReport.GameEventCount, StringFormat=Events: {0}}" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding LastExportReport.ActionReactionCount, StringFormat=Reactions: {0}}" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding LastExportReport.EndingCount, StringFormat=Endings: {0}}" Margin="0,4,0,0"/>
                            </Grid>

                            <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Export 対象 (Accepted のみ)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="警告" FontWeight="SemiBold" Margin="0,0,0,8"/>

                                <DataGrid Grid.Row="1"
                                          Grid.Column="0"
                                          ItemsSource="{Binding AcceptedAssets}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="AssetId" Binding="{Binding AssetId}" Width="140"/>
                                        <DataGridTextColumn Header="用途" Binding="{Binding Usage}" Width="90"/>
                                        <DataGridTextColumn Header="状態" Binding="{Binding Status}" Width="90"/>
                                        <DataGridTextColumn Header="ファイル名" Binding="{Binding FileName}" Width="160"/>
                                        <DataGridTextColumn Header="Prompt" Binding="{Binding PromptRecordPath}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <ListBox Grid.Row="1"
                                         Grid.Column="2"
                                         ItemsSource="{Binding LastExportReport.Warnings}"/>
                            </Grid>

                            <StackPanel Grid.Row="4"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,12,0,0">
                                <Button Content="出力先を開く"
                                        Command="{Binding OpenExportDirectoryCommand}"
                                        Width="120"
                                        Height="30"
                                        Margin="0,0,8,0"/>
                                <Button Content="Export 実行"
                                        Command="{Binding ExportSelectedProfileCommand}"
                                        Width="140"
                                        Height="30"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <TextBox Grid.Row="2" Text="{Binding StatusMessage}" Foreground="#444444" Margin="0,12,0,0" IsReadOnly="True" />
    </Grid>
</Window>
