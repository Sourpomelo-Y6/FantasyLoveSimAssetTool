                                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                                <DataTemplate>
                                                                    <ComboBox SelectedItem="{Binding TargetId, UpdateSourceTrigger=PropertyChanged}">
                                                                        <ComboBox.ItemsSource>
                                                                            <MultiBinding Converter="{StaticResource SkillConditionTargetOptionsConverter}">
                                                                                <Binding Path="Scope"/>
                                                                                <Binding Path="Data.TrainingIdOptions" Source="{StaticResource ViewModelProxy}"/>
                                                                                <Binding Path="Data.TrainingCategoryIdOptions" Source="{StaticResource ViewModelProxy}"/>
                                                                                <Binding Path="Data.EnemyIdOptions" Source="{StaticResource ViewModelProxy}"/>
                                                                            </MultiBinding>
                                                                        </ComboBox.ItemsSource>
                                                                    </ComboBox>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellEditingTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTextColumn Header="必要値" Binding="{Binding RequiredValue, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </Grid>
                                        </GroupBox>
                                        <Expander Grid.Row="4" Header="AI文章作成" Margin="0,12,0,0" IsExpanded="False">
