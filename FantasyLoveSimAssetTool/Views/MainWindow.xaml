                                            <TextBox Text="{Binding GameEventTestItemId, UpdateSourceTrigger=PropertyChanged}" Width="72" Margin="0,0,8,0"/>
                                            <TextBlock Text="Flags" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBox Text="{Binding GameEventTestFlagIdsText, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                                        </StackPanel>
                                    </Grid>

