<Window x:Class="FantasyLoveSimAssetTool.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FantasyLoveSimAssetTool.ViewModels"
        xmlns:local="clr-namespace:FantasyLoveSimAssetTool.Views"
        mc:Ignorable="d"
        Title="FantasyLoveSimAssetTool" Height="980" Width="1500">
    <Window.DataContext>
        <vm:MainWindowModel/>
    </Window.DataContext>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="FantasyLoveSimAssetTool" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding WorkspacePath, StringFormat=Workspace: {0}}" Foreground="Gray" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="1" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="キャラクター" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <TextBlock Text="HeroineId"/>
                        <TextBox Text="{Binding HeroineIdInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>

                        <TextBlock Text="表示名"/>
                        <TextBox Text="{Binding DisplayNameInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>

                        <Button Content="新規作成" Command="{Binding CreateCharacterCommand}" Height="28"/>
                        <Button Content="再読み込み" Command="{Binding RefreshProfilesCommand}" Height="28" Margin="0,8,0,0"/>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Profiles}"
                             SelectedItem="{Binding SelectedProfile}"
                             DisplayMemberPath="DisplayName"/>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" BorderBrush="#DDDDDD" BorderThickness="1" Padding="12">
                <TabControl>
                    <TabItem Header="基本情報">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="HeroineId" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedProfile.HeroineId}" IsReadOnly="True" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="表示名" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedProfile.DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="年齢" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedProfile.Age, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="身長" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedProfile.Height, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="性格" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SelectedProfile.Personality, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="56" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="口調" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding SelectedProfile.SpeakingStyle, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="56" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="一人称" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding SelectedProfile.FirstPerson, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="二人称" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding SelectedProfile.SecondPerson, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="好きなもの" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding SelectedProfile.Likes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="56" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="9" Grid.Column="0" Text="苦手なもの" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding SelectedProfile.Dislikes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="56" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="10" Grid.Column="0" Text="容姿プロンプト" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding SelectedProfile.AppearancePrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="72" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="11" Grid.Column="0" Text="行動反応方針" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding SelectedProfile.ActionReactionPolicy, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="64" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="12" Grid.Column="0" Text="エンディング方針" VerticalAlignment="Top" Margin="0,4,8,0"/>
                                    <TextBox Grid.Row="12" Grid.Column="1" Text="{Binding SelectedProfile.EndingPolicy, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="64" TextWrapping="Wrap"/>
                                </Grid>
                            </ScrollViewer>

                            <Button Grid.Row="1" Content="保存" Command="{Binding SaveSelectedProfileCommand}" Width="120" Height="30" HorizontalAlignment="Right" Margin="0,12,0,0"/>
                        </Grid>
                    </TabItem>

                    <TabItem Header="画像">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="96"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="AssetId" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding AssetIdInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="元画像" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="1"
                                         Grid.Column="1"
                                         Text="{Binding ImageSourcePathInput, UpdateSourceTrigger=PropertyChanged}"
                                         AllowDrop="True"
                                         PreviewDragOver="ImageSourcePath_PreviewDragOver"
                                         Drop="ImageSourcePath_Drop"
                                         Margin="0,0,8,8"/>
                                <Button Grid.Row="1" Grid.Column="2" Content="参照" Command="{Binding BrowseImageCommand}" Height="26" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="用途" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding AssetUsages}" SelectedItem="{Binding SelectedAssetUsage}" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="状態" VerticalAlignment="Center"/>
                                <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding AssetStatuses}" SelectedItem="{Binding SelectedAssetStatus}" Margin="0,0,8,0"/>
                                <Button Grid.Row="3" Grid.Column="2" Content="画像登録" Command="{Binding AddImageAssetCommand}" Height="26"/>
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="登録済み画像" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Status" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{Binding AssetStatusFilters}"
                                              SelectedItem="{Binding SelectedAssetStatusFilter}"
                                              Height="24"/>
                                </Grid>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="プレビュー" FontWeight="SemiBold" Margin="0,0,0,8"/>

                                <DataGrid Grid.Row="1"
                                          Grid.Column="0"
                                          ItemsSource="{Binding FilteredAssets}"
                                          SelectedItem="{Binding SelectedAsset}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="AssetId" Binding="{Binding AssetId}" Width="140" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="用途" Binding="{Binding Usage}" Width="90" IsReadOnly="True"/>
                                        <DataGridComboBoxColumn Header="状態"
                                                                SelectedItemBinding="{Binding Status}"
                                                                ItemsSource="{Binding DataContext.AssetStatuses, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Width="100"/>
                                        <DataGridTextColumn Header="ファイル名" Binding="{Binding FileName}" Width="160" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="保存先" Binding="{Binding StoredPath}" Width="*" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Button Grid.Row="2"
                                        Grid.Column="0"
                                        Content="画像情報保存"
                                        Command="{Binding SaveImageAssetsCommand}"
                                        Width="140"
                                        Height="28"
                                        HorizontalAlignment="Right"
                                        Margin="0,8,0,0"/>

                                <Border Grid.Row="1"
                                        Grid.Column="2"
                                        BorderBrush="#DDDDDD"
                                        BorderThickness="1"
                                        Padding="8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Image Grid.Row="0"
                                               Source="{Binding SelectedAssetImagePath, Mode=OneWay}"
                                               Stretch="Uniform"/>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding SelectedAssetImageMessage}"
                                                   Foreground="Gray"
                                                   TextWrapping="Wrap"
                                                   Margin="0,8,0,0"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="スチル作業">
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    BorderBrush="#DDDDDD"
                                    BorderThickness="1"
                                    Padding="10">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top"
                                               Text="作成対象"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8"/>

                                    <ComboBox DockPanel.Dock="Top"
                                              ItemsSource="{Binding StillUsageFilters}"
                                              SelectedItem="{Binding SelectedStillUsageFilter}"
                                              Margin="0,0,0,8"/>

                                    <ListBox ItemsSource="{Binding FilteredStillDefinitions}"
                                             SelectedItem="{Binding SelectedStillDefinition}"
                                             BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4,0,6">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Row="0"
                                                               Grid.Column="0"
                                                               Text="{Binding DisplayName}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Row="0"
                                                               Grid.Column="1"
                                                               Text="{Binding Status}"
                                                               Foreground="Gray"
                                                               Margin="8,0,0,0"/>
                                                    <TextBlock Grid.Row="1"
                                                               Grid.Column="0"
                                                               Grid.ColumnSpan="2"
                                                               Text="{Binding AssetId}"
                                                               Foreground="Gray"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Grid.ColumnSpan="4"
                                           Text="{Binding SelectedStillDefinition.DisplayName}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,12"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="AssetId" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedStillDefinition.AssetId}" IsReadOnly="True" Margin="0,0,12,8"/>

                                <TextBlock Grid.Row="1" Grid.Column="2" Text="状態" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <ComboBox Grid.Row="1"
                                          Grid.Column="3"
                                          ItemsSource="{Binding StillStatuses}"
                                          SelectedItem="{Binding SelectedStillDefinition.Status}"
                                          Margin="0,0,0,8"/>

                                <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="72"/>
                                        <RowDefinition Height="70"/>
                                        <RowDefinition Height="120"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="220"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="状況" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding SelectedStillImageStatusText}" Margin="0,0,16,0"/>
                                        <TextBlock Text="{Binding SelectedStillPromptStatusText}" Margin="0,0,16,0"/>
                                        <TextBlock Text="{Binding SelectedStillAssetStatusText}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="用途" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedStillDefinition.Usage}" IsReadOnly="True" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="出力ファイル" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedStillDefinition.FileName}" IsReadOnly="True" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="追加 prompt" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="3"
                                             Grid.Column="1"
                                             Text="{Binding SelectedStillDefinition.SpecificPrompt, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             Height="76"
                                             TextWrapping="Wrap"
                                             Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="negative prompt" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="4"
                                             Grid.Column="1"
                                             Text="{Binding CurrentPromptRecord.NegativePrompt, Mode=OneWay}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Comfy 結果" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="5"
                                             Grid.Column="1"
                                             Text="{Binding CurrentComfyResultSummary, Mode=OneWay}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="合成 prompt" VerticalAlignment="Top" Margin="0,4,8,0"/>
                                    <TextBox Grid.Row="6"
                                             Grid.Column="1"
                                             Text="{Binding StillPromptPreview, Mode=OneWay}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="workflow preview" VerticalAlignment="Top" Margin="0,4,8,0"/>
                                    <TextBox Grid.Row="7"
                                             Grid.Column="1"
                                             Text="{Binding CurrentComfyWorkflowPreview, Mode=OneWay}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             HorizontalScrollBarVisibility="Auto"
                                             VerticalScrollBarVisibility="Auto"/>

                                    <Border Grid.Row="0"
                                            Grid.Column="3"
                                            Grid.RowSpan="8"
                                            BorderBrush="#DDDDDD"
                                            BorderThickness="1"
                                            Padding="8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="12"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Image Grid.Row="0"
                                                   Source="{Binding SelectedStillImagePath, Mode=OneWay}"
                                                   Stretch="Uniform"/>
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding SelectedStillImageMessage}"
                                                       Foreground="Gray"
                                                       TextWrapping="Wrap"
                                                       Margin="0,8,0,0"/>
                                            <Image Grid.Row="3"
                                                   Source="{Binding CurrentComfyPreviewImagePath, Mode=OneWay}"
                                                   Stretch="Uniform"/>
                                            <TextBlock Grid.Row="4"
                                                       Text="{Binding CurrentComfyPreviewImageMessage}"
                                                       Foreground="Gray"
                                                       TextWrapping="Wrap"
                                                       Margin="0,8,0,0"/>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <WrapPanel Grid.Row="3"
                                           Grid.Column="1"
                                           Grid.ColumnSpan="3"
                                           HorizontalAlignment="Right"
                                           Margin="0,12,0,0">
                                    <Button Content="画像登録欄に反映"
                                            Command="{Binding PrepareImageRegistrationForStillCommand}"
                                            Width="150"
                                            Height="30"
                                            Margin="0,0,8,8"/>
                                    <Button Content="Prompt に反映"
                                            Command="{Binding ApplyStillPromptCommand}"
                                            Width="140"
                                            Height="30"
                                            Margin="0,0,8,8"/>
                                    <Button Content="Comfy 作成"
                                            Command="{Binding BuildStillComfyWorkflowPreviewCommand}"
                                            Width="110"
                                            Height="30"
                                            Margin="0,0,8,8"/>
                                    <Button Content="Comfy 送信"
                                            Command="{Binding SubmitStillComfyPromptCommand}"
                                            Width="110"
                                            Height="30"
                                            Margin="0,0,8,8"/>
                                    <Button Content="待機キャンセル"
                                            Command="{Binding CancelStillComfyPollingCommand}"
                                            Width="110"
                                            Height="30"
                                            Margin="0,0,8,8"/>
                                    <Button Content="結果確認"
                                            Command="{Binding CheckStillComfyResultCommand}"
                                            Width="90"
                                            Height="30"
                                            Margin="0,0,8,8"/>
                                    <Button Content="画像取得"
                                            Command="{Binding FetchStillComfyImageCommand}"
                                            Width="90"
                                            Height="30"
                                            Margin="0,0,8,8"/>
                                    <Button Content="Comfy 採用"
                                            Command="{Binding AdoptStillComfyImageCommand}"
                                            Width="100"
                                            Height="30"
                                            Margin="0,0,8,8"/>
                                    <Button Content="スチル保存"
                                            Command="{Binding SaveSelectedProfileCommand}"
                                            Width="110"
                                            Height="30"
                                            Margin="0,0,0,8"/>
                                </WrapPanel>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="スチル一覧">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="仕様書で常に作成するスチル候補です。キャラクターの容姿プロンプトに SpecificPrompt を足して画像生成します。"
                                       Foreground="Gray"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>

                            <Button Grid.Row="1"
                                    Content="Prompt に反映"
                                    Command="{Binding ApplyStillPromptCommand}"
                                    Width="140"
                                    Height="28"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,0,8"/>

                            <DataGrid Grid.Row="2"
                                      ItemsSource="{Binding StillDefinitions}"
                                      SelectedItem="{Binding SelectedStillDefinition}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="AssetId" Binding="{Binding AssetId}" Width="150" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="用途" Binding="{Binding Usage}" Width="90" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="表示名" Binding="{Binding DisplayName}" Width="150" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="ファイル名" Binding="{Binding FileName}" Width="170" IsReadOnly="True"/>
                                    <DataGridTemplateColumn Header="状態" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Status}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding DataContext.StillStatuses, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding Status, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="SpecificPrompt"
                                                        Binding="{Binding SpecificPrompt, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Prompt">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Grid.ColumnSpan="3"
                                           Text="{Binding SelectedAsset.AssetId, StringFormat=選択中 Asset: {0}}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="テンプレート" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel Grid.Row="1"
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            Margin="0,0,8,0">
                                    <ComboBox ItemsSource="{Binding AssetUsages}"
                                              SelectedItem="{Binding SelectedPromptTemplateUsage}"
                                              Width="120"
                                              Margin="0,0,8,0"/>
                                    <ComboBox ItemsSource="{Binding AvailablePromptTemplates}"
                                              SelectedItem="{Binding SelectedPromptTemplate}"
                                              DisplayMemberPath="DisplayName"
                                              Width="320"/>
                                </StackPanel>
                                <Button Grid.Row="1" Grid.Column="2" Content="適用" Command="{Binding ApplyPromptTemplateCommand}" Height="26"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="ComfyUI" VerticalAlignment="Center" Margin="0,8,8,0"/>
                                <TextBox Grid.Row="2"
                                         Grid.Column="1"
                                         Text="{Binding ComfySettingsSummary}"
                                         IsReadOnly="True"
                                         Margin="0,8,8,0"/>
                                <StackPanel Grid.Row="2"
                                            Grid.Column="2"
                                            Orientation="Horizontal"
                                            Margin="0,8,0,0">
                                    <Button Content="設定再読込"
                                            Command="{Binding ReloadComfySettingsCommand}"
                                            Width="84"
                                            Height="26"
                                            Margin="0,0,4,0"/>
                                    <Button Content="作成"
                                            Command="{Binding BuildComfyWorkflowPreviewCommand}"
                                            Width="52"
                                            Height="26"/>
                                </StackPanel>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="positive prompt" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding CurrentPromptRecord.PositivePrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="86" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="negative prompt" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding CurrentPromptRecord.NegativePrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="model" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CurrentPromptRecord.Model, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,8"/>

                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="VAE" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding CurrentPromptRecord.Vae, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="LoRA" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CurrentPromptRecord.Lora, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,8"/>

                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="sampler" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding CurrentPromptRecord.Sampler, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="steps" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CurrentPromptRecord.Steps, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,8"/>

                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="CFG scale" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="4" Grid.Column="3" Text="{Binding CurrentPromptRecord.CfgScale, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="seed" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding CurrentPromptRecord.Seed, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,8"/>

                                    <TextBlock Grid.Row="5" Grid.Column="2" Text="image size" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <StackPanel Grid.Row="5" Grid.Column="3" Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBox Text="{Binding CurrentPromptRecord.ImageWidth, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                        <TextBlock Text=" x " VerticalAlignment="Center" Margin="6,0"/>
                                        <TextBox Text="{Binding CurrentPromptRecord.ImageHeight, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="ControlNet" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding CurrentPromptRecord.ControlNetMemo, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="48" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="upscale" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding CurrentPromptRecord.UpscaleMemo, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="48" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="inpaint / img2img" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding CurrentPromptRecord.InpaintMemo, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="48" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="9" Grid.Column="0" Text="採用理由" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding CurrentPromptRecord.AdoptionReason, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="56" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="10" Grid.Column="0" Text="修正メモ" VerticalAlignment="Top" Margin="0,4,8,0"/>
                                    <TextBox Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding CurrentPromptRecord.RevisionMemo, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="56" TextWrapping="Wrap"/>

                                    <TextBlock Grid.Row="11" Grid.Column="0" Text="Comfy workflow" VerticalAlignment="Top" Margin="0,12,8,0"/>
                                    <TextBox Grid.Row="11"
                                             Grid.Column="1"
                                             Grid.ColumnSpan="3"
                                             Text="{Binding CurrentComfyWorkflowPreview}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             Height="140"
                                             TextWrapping="NoWrap"
                                             HorizontalScrollBarVisibility="Auto"
                                             VerticalScrollBarVisibility="Auto"
                                             Margin="0,8,0,0"/>
                                </Grid>
                            </ScrollViewer>

                            <Button Grid.Row="2" Content="Prompt 保存" Command="{Binding SavePromptRecordCommand}" Width="140" Height="30" HorizontalAlignment="Right" Margin="0,12,0,0"/>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Export">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="出力先" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ExportPath, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="2"
                                       Text="Accepted の画像、対応する prompt JSON、Data 下書き Markdown を Unity 取り込み用に出力します。"
                                       Foreground="Gray"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>

                            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding LastExportReport.AcceptedAssetCount, StringFormat=Accepted: {0}}"/>
                                <TextBlock Grid.Column="1" Text="{Binding LastExportReport.ExportedImageCount, StringFormat=Images: {0}}"/>
                                <TextBlock Grid.Column="2" Text="{Binding LastExportReport.ExportedPromptCount, StringFormat=Prompts: {0}}"/>
                                <TextBlock Grid.Column="3" Text="{Binding LastExportReport.SkippedImageCount, StringFormat=Skipped: {0}}"/>
                            </Grid>

                            <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Export 対象 (Accepted のみ)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="警告" FontWeight="SemiBold" Margin="0,0,0,8"/>

                                <DataGrid Grid.Row="1"
                                          Grid.Column="0"
                                          ItemsSource="{Binding AcceptedAssets}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="AssetId" Binding="{Binding AssetId}" Width="140"/>
                                        <DataGridTextColumn Header="用途" Binding="{Binding Usage}" Width="90"/>
                                        <DataGridTextColumn Header="状態" Binding="{Binding Status}" Width="90"/>
                                        <DataGridTextColumn Header="ファイル名" Binding="{Binding FileName}" Width="160"/>
                                        <DataGridTextColumn Header="Prompt" Binding="{Binding PromptRecordPath}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <ListBox Grid.Row="1"
                                         Grid.Column="2"
                                         ItemsSource="{Binding LastExportReport.Warnings}"/>
                            </Grid>

                            <StackPanel Grid.Row="4"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,12,0,0">
                                <Button Content="出力先を開く"
                                        Command="{Binding OpenExportDirectoryCommand}"
                                        Width="120"
                                        Height="30"
                                        Margin="0,0,8,0"/>
                                <Button Content="Export 実行"
                                        Command="{Binding ExportSelectedProfileCommand}"
                                        Width="140"
                                        Height="30"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <TextBox Grid.Row="2" Text="{Binding StatusMessage}" Foreground="#444444" Margin="0,12,0,0" IsReadOnly="True" />
    </Grid>
</Window>
