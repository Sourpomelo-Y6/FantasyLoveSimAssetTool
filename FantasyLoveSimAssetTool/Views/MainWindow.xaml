                                            <TextBox Text="{Binding GameEventTestWeather, UpdateSourceTrigger=PropertyChanged}" Width="72"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="3"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="4"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,6,0,0">
                                            <TextBlock Text="季節" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBox Text="{Binding GameEventTestSeason, UpdateSourceTrigger=PropertyChanged}" Width="72" Margin="0,0,8,0"/>
