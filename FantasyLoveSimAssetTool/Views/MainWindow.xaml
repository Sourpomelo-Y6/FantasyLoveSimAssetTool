                                            <DataGridTextColumn Header="OutfitId"
                                                                Width="140"
                                                                Binding="{Binding OutfitId, UpdateSourceTrigger=PropertyChanged}"/>
                                            <DataGridTextColumn Header="lockedMessage"
                                                                Width="*"
                                                                Binding="{Binding LockedMessage, UpdateSourceTrigger=PropertyChanged}"/>
                                            <DataGridTemplateColumn Header="locked表情" Width="130">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding Data.ExpressionIdOptions, Source={StaticResource ViewModelProxy}}"
                                                                  Text="{Binding LockedExpressionId, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsEditable="True"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="changedMessage"
                                                                Width="*"
                                                                Binding="{Binding ChangedMessage, UpdateSourceTrigger=PropertyChanged}"/>
                                            <DataGridTemplateColumn Header="changed表情" Width="130">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding Data.ExpressionIdOptions, Source={StaticResource ViewModelProxy}}"
                                                                  Text="{Binding ChangedExpressionId, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsEditable="True"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="衣装反応メッセージ override"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                Content="4項目を補完"
                                                Command="{Binding PopulateOutfitReactionMessagesCommand}"
                                                Height="26"
                                                MinWidth="110"
                                                ToolTip="Praise、Dislike、Bored、Change の未登録項目を追加します"
                                                Margin="0,0,8,0"/>
                                        <Button Grid.Column="2"
                                                Content="追加"
                                                Command="{Binding AddOutfitReactionMessageOverrideCommand}"
                                                Height="26"
                                                MinWidth="72"
                                                Margin="0,0,8,0"/>
                                        <Button Grid.Column="3"
                                                Content="削除"
                                                Command="{Binding RemoveOutfitReactionMessageOverrideCommand}"
                                                Height="26"
                                                MinWidth="72"/>
                                    </Grid>

                                    <DataGrid Grid.Row="3"
                                              Grid.Column="0"
                                              Grid.ColumnSpan="2"
                                              ItemsSource="{Binding SelectedProfile.OutfitReactionMessageOverrides}"
                                              SelectedItem="{Binding SelectedOutfitReactionMessageOverride}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              Height="190">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="reactionType"
                                                                Width="160"
                                                                Binding="{Binding ReactionType, UpdateSourceTrigger=PropertyChanged}"/>
                                            <DataGridTextColumn Header="message"
                                                                Width="*"
                                                                Binding="{Binding Message, UpdateSourceTrigger=PropertyChanged}"/>
                                            <DataGridTemplateColumn Header="表情" Width="150">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding Data.ExpressionIdOptions, Source={StaticResource ViewModelProxy}}"
                                                                  Text="{Binding ExpressionId, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsEditable="True"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                            <local:LocalAiShortTextPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                                                         TargetGroup="Outfit"/>
                                        </Grid>
                                    </ScrollViewer>
                                </TabItem>

                                <TabItem Header="{Binding ConversationAiSettingsTabHeader}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                                        <StackPanel Margin="12,12,18,18">
                                            <TextBlock Text="キャラクター固有プロンプト"
                                                       FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock Text="このキャラクターのすべての会話AI生成で共通して使用する設定です。会話本文の生成操作は会話データタブにあります。"
                                                       Foreground="#666666" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                            <TextBlock Text="画面下部の基本情報『保存』とは別ファイルです。このページの『固有プロンプトを保存』で確定します。"
                                                       Foreground="#9A5B20" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                            <TextBlock Text="{Binding ConversationCharacterPromptStatus}"
                                                       Foreground="#665A72" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding ConversationCharacterPromptEditStatus}"
                                                       Foreground="#765D24" TextWrapping="Wrap" Margin="0,0,0,12"/>
