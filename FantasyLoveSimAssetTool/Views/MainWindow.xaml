                                                  Grid.Column="3"
                                                  ItemsSource="{Binding ConversationCategoryFilters}"
                                                  SelectedItem="{Binding SelectedConversationCategoryFilter}"
                                                  Height="26"/>
                                        <CheckBox Grid.Row="1"
                                                  Grid.Column="0"
                                                  Grid.ColumnSpan="2"
                                                  Content="警告ありのみ"
                                                  IsChecked="{Binding ShowOnlyConversationWarnings}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,6,8,0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="画像" VerticalAlignment="Center" Margin="0,6,8,0"/>
                                        <ComboBox Grid.Row="1"
                                                  Grid.Column="3"
                                                  ItemsSource="{Binding ConversationImageFilters}"
                                                  SelectedItem="{Binding SelectedConversationImageFilter}"
                                                  Height="26"
                                                  Margin="0,6,0,0"/>
