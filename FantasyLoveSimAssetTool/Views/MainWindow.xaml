                                                Height="26"
                                                MinWidth="76"
                                                Margin="0,0,6,6"/>
                                        <Button Content="Comfy 採用"
                                                Command="{Binding AdoptPlayerComfyImageCommand}"
                                                Height="26"
                                                MinWidth="88"
                                                Margin="0,0,6,6"/>
                                        <Button Content="停止"
                                                Command="{Binding InterruptComfyGenerationCommand}"
                                                Height="26"
                                                MinWidth="60"
                                                Margin="0,0,0,6"/>
                                    </WrapPanel>
                                </Grid>
                            </Grid>

                            <Grid Grid.Row="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="プレイヤー画像一覧" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <Button Grid.Row="0"
                                        Grid.Column="0"
                                        Content="標準候補追加"
                                        Command="{Binding AddPlayerStandardAssetDataCommand}"
                                        Height="26"
                                        Width="112"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,0,8"/>
                                <StackPanel Grid.Row="0"
                                            Grid.Column="2"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,0,0,8">
                                    <TextBlock Text="{Binding LastPlayerExportReport.ExportedImageCount, StringFormat=Images: {0}}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding LastPlayerExportReport.Warnings.Count, StringFormat=Warnings: {0}}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <Button Content="Player Export"
                                            Command="{Binding ExportPlayerCommand}"
                                            Height="26"
                                            MinWidth="112"/>
                                </StackPanel>

                                <DataGrid Grid.Row="1"
                                          Grid.Column="0"
                                          ItemsSource="{Binding PlayerProfile.Assets}"
                                          SelectedItem="{Binding SelectedPlayerAsset}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="AssetId" Binding="{Binding AssetId}" Width="170" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="用途" Binding="{Binding Usage}" Width="80" IsReadOnly="True"/>
                                        <DataGridComboBoxColumn Header="状態"
                                                                SelectedItemBinding="{Binding Status}"
                                                                ItemsSource="{Binding Data.AssetStatuses, Source={StaticResource ViewModelProxy}}"
                                                                Width="100"/>
                                        <DataGridTextColumn Header="メモ" Binding="{Binding Memo, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                                        <DataGridTextColumn Header="ファイル名" Binding="{Binding FileName}" Width="170" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="保存先" Binding="{Binding StoredPath}" Width="*" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Button Grid.Row="2"
                                        Grid.Column="0"
                                        Content="登録解除"
                                        Command="{Binding UnregisterPlayerImageAssetCommand}"
                                        Width="100"
                                        Height="28"
                                        HorizontalAlignment="Right"
                                        Margin="0,8,0,0"/>

                                <Border Grid.Row="1"
                                        Grid.Column="2"
                                        BorderBrush="#DDDDDD"
                                        BorderThickness="1"
                                        Padding="8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Image Grid.Row="0"
                                               Source="{Binding SelectedPlayerAssetImagePath, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                               Stretch="Uniform"/>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding SelectedPlayerAssetImageMessage}"
                                                   Foreground="Gray"
                                                   TextWrapping="Wrap"
                                                   Margin="0,8,0,0"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="スチル作業">
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    BorderBrush="#DDDDDD"
                                    BorderThickness="1"
                                    Padding="10">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top"
                                               Text="作成対象"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8"/>
                                    <TextBlock DockPanel.Dock="Top"
                                               Text="通常のスチル生成、登録、採用作業はこのタブで行います。"
                                               Foreground="Gray"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>

                                    <ComboBox DockPanel.Dock="Top"
                                              ItemsSource="{Binding StillUsageFilters}"
                                              SelectedItem="{Binding SelectedStillUsageFilter}"
                                              Margin="0,0,0,8"/>

                                    <ListBox ItemsSource="{Binding FilteredStillDefinitions}"
                                             SelectedItem="{Binding SelectedStillDefinition}"
                                             BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4,0,6">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Row="0"
                                                               Grid.Column="0"
                                                               Text="{Binding DisplayName}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Row="0"
                                                               Grid.Column="1"
                                                               Text="{Binding Status}"
                                                               Foreground="Gray"
                                                               Margin="8,0,0,0"/>
                                                    <TextBlock Grid.Row="1"
                                                               Grid.Column="0"
                                                               Grid.ColumnSpan="2"
                                                               Text="{Binding AssetId}"
                                                               Foreground="Gray"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Grid.ColumnSpan="4"
                                           Text="{Binding SelectedStillDefinition.DisplayName}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,12"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="AssetId" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedStillDefinition.AssetId}" IsReadOnly="True" Margin="0,0,12,8"/>

                                <TextBlock Grid.Row="1" Grid.Column="2" Text="状態" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <ComboBox Grid.Row="1"
                                          Grid.Column="3"
                                          ItemsSource="{Binding StillStatuses}"
                                          SelectedItem="{Binding SelectedStillDefinition.Status}"
                                          Margin="0,0,0,8"/>

                                <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="72"/>
                                        <RowDefinition Height="70"/>
                                        <RowDefinition Height="70"/>
                                        <RowDefinition Height="120"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="220"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="状況" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding SelectedStillImageStatusText}" Margin="0,0,16,0"/>
                                        <TextBlock Text="{Binding SelectedStillPromptStatusText}" Margin="0,0,16,0"/>
                                        <TextBlock Text="{Binding SelectedStillAssetStatusText}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="用途" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedStillDefinition.Usage}" IsReadOnly="True" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="出力ファイル" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedStillDefinition.FileName}" IsReadOnly="True" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="追加 prompt" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="3"
                                             Grid.Column="1"
                                             Text="{Binding SelectedStillDefinition.SpecificPrompt, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             Height="76"
                                             TextWrapping="Wrap"
                                             Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="negative prompt" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="4"
                                             Grid.Column="1"
                                             Text="{Binding CurrentPromptRecord.NegativePrompt, Mode=OneWay}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="negative 追加" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="5"
                                             Grid.Column="1"
                                             Text="{Binding SelectedStillDefinition.NegativePromptAddition, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Comfy 結果" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="6"
                                             Grid.Column="1"
                                             Text="{Binding CurrentComfyResultSummary, Mode=OneWay}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="合成 prompt" VerticalAlignment="Top" Margin="0,4,8,0"/>
                                    <TextBox Grid.Row="7"
                                             Grid.Column="1"
                                             Text="{Binding StillPromptPreview, Mode=OneWay}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="workflow preview" VerticalAlignment="Top" Margin="0,4,8,0"/>
                                    <TextBox Grid.Row="8"
                                             Grid.Column="1"
                                             Text="{Binding CurrentComfyWorkflowPreview, Mode=OneWay}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             HorizontalScrollBarVisibility="Auto"
                                             VerticalScrollBarVisibility="Auto"/>

                                    <Border Grid.Row="0"
                                            Grid.Column="3"
                                            Grid.RowSpan="9"
                                            BorderBrush="#DDDDDD"
                                            BorderThickness="1"
                                            Padding="8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="12"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Image Grid.Row="0"
                                                   Source="{Binding SelectedStillImagePath, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                                   Stretch="Uniform"/>
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding SelectedStillImageMessage}"
                                                       Foreground="Gray"
                                                       TextWrapping="Wrap"
                                                       Margin="0,8,0,0"/>
                                            <Image Grid.Row="3"
                                                   Source="{Binding CurrentComfyPreviewImagePath, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                                   Stretch="Uniform"/>
                                            <TextBlock Grid.Row="4"
                                                       Text="{Binding CurrentComfyPreviewImageMessage}"
                                                       Foreground="Gray"
                                                       TextWrapping="Wrap"
                                                       Margin="0,8,0,0"/>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <WrapPanel Grid.Row="3"
                                           Grid.Column="1"
                                           Grid.ColumnSpan="3"
                                           HorizontalAlignment="Right"
                                           Margin="0,12,0,0">
                                    <Button Content="画像登録欄に反映"
                                            Command="{Binding PrepareImageRegistrationForStillCommand}"
                                            Width="150"
                                            Height="30"
                                            Margin="0,0,8,8"/>
                                    <Button Content="Prompt に反映"
                                            Command="{Binding ApplyStillPromptCommand}"
                                            Width="140"
                                            Height="30"
                                            Margin="0,0,8,8"/>
                                    <Button Content="Comfy 作成"
                                            Command="{Binding BuildStillComfyWorkflowPreviewCommand}"
                                            Width="110"
                                            Height="30"
                                            Margin="0,0,8,8"/>
                                    <Button Content="Comfy 送信"
                                            Command="{Binding SubmitStillComfyPromptCommand}"
                                            Width="110"
                                            Height="30"
                                            Margin="0,0,8,8"/>
                                    <Button Content="待機キャンセル"
                                            Command="{Binding CancelStillComfyPollingCommand}"
                                            Width="110"
                                            Height="30"
                                            Margin="0,0,8,8"/>
                                    <Button Content="Comfy 停止"
                                            Command="{Binding InterruptComfyGenerationCommand}"
                                            Width="100"
                                            Height="30"
                                            Margin="0,0,8,8"/>
                                    <Button Content="結果確認"
                                            Command="{Binding CheckStillComfyResultCommand}"
                                            Width="90"
                                            Height="30"
                                            Margin="0,0,8,8"/>
                                    <Button Content="画像取得"
                                            Command="{Binding FetchStillComfyImageCommand}"
                                            Width="90"
                                            Height="30"
                                            Margin="0,0,8,8"/>
                                    <Button Content="Comfy 採用"
                                            Command="{Binding AdoptStillComfyImageCommand}"
                                            Width="100"
                                            Height="30"
                                            Margin="0,0,8,8"/>
                                    <Button Content="スチル保存"
                                            Command="{Binding SaveSelectedProfileCommand}"
                                            Width="110"
                                            Height="30"
                                            Margin="0,0,0,8"/>
                                </WrapPanel>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="メニュー設定">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="160"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="ヒロイン別メインメニュー"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                                <TextBlock Margin="0,4,0,8"
                                           Foreground="Gray"
                                           TextWrapping="Wrap"
                                           Text="配置列は 0=自動、1=左、2=中央、3=右です。標準項目を準備は不足分だけを追加し、標準配置へ戻すは標準13項目の表示名・列・順序・実行種別を修復します。"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="標準項目を準備"
                                            Command="{Binding PrepareStandardMenuActionsCommand}"
                                            Width="150" Height="28" Margin="0,0,8,0"/>
                                    <Button Content="標準配置へ戻す"
                                            Command="{Binding ApplyStandardMenuLayoutCommand}"
                                            Width="150" Height="28" Margin="0,0,8,0"/>
                                    <Button Content="項目を追加"
                                            Command="{Binding AddMenuActionCommand}"
                                            Width="110" Height="28" Margin="0,0,8,0"/>
                                    <Button Content="選択項目を削除"
                                            Command="{Binding RemoveMenuActionCommand}"
                                            Width="130" Height="28" Margin="0,0,8,0"/>
                                    <Button Content="検証"
                                            Command="{Binding ValidateMenuActionsCommand}"
                                            Width="90" Height="28"/>
                                </StackPanel>
                            </StackPanel>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding SelectedProfile.MenuActions}"
                                      SelectedItem="{Binding SelectedMenuAction, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Single"
                                      Margin="0,0,0,12">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ActionId"
                                                        Binding="{Binding ActionId, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="150"/>
                                    <DataGridTextColumn Header="表示名"
                                                        Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="150"/>
                                    <DataGridTemplateColumn Header="配置列" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding Data.MenuActionColumnOptions, Source={StaticResource ViewModelProxy}}"
                                                          DisplayMemberPath="Value"
                                                          SelectedValuePath="Key"
                                                          SelectedValue="{Binding DisplayColumn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="表示順"
                                                        Binding="{Binding SortOrder, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="80"/>
                                    <DataGridTemplateColumn Header="実行種別" Width="220">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding Data.MenuActionExecutionTypes, Source={StaticResource ViewModelProxy}}"
                                                          SelectedItem="{Binding ExecutionType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridCheckBoxColumn Header="有効"
                                                            Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="65"/>
                                    <DataGridCheckBoxColumn Header="必須"
                                                            Binding="{Binding IsRequired, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="65"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <GroupBox Grid.Row="2" Header="検証結果" Margin="0,0,0,12">
                                <ListBox ItemsSource="{Binding MenuActionWarnings}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#B04030" Margin="4,2"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </GroupBox>

                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="編集後は保存し、Export後にUnityで Heroine Export Import を実行してください。"
                                           Foreground="Gray" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button Content="保存"
                                        Command="{Binding SaveSelectedProfileCommand}"
                                        Width="120" Height="30"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="差分定義">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="表情、衣装、透過レイヤー素材の共通定義を編集します。保存すると Definitions/*.json に反映され、スチル作業タブと Export に使われます。"
                                       Foreground="Gray"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>

                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                                        <TextBlock Text="表情定義" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                            <Button Content="追加"
                                                    Command="{Binding AddExpressionDefinitionCommand}"
                                                    Width="70"
                                                    Height="26"
                                                    Margin="8,0,0,0"/>
                                            <Button Content="削除"
                                                    Command="{Binding RemoveExpressionDefinitionCommand}"
                                                    Width="70"
                                                    Height="26"
                                                    Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <DataGrid Grid.Row="1"
                                              ItemsSource="{Binding ExpressionDefinitions}"
                                              SelectedItem="{Binding SelectedExpressionDefinition}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ExpressionId" Binding="{Binding ExpressionId, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                                            <DataGridTextColumn Header="表示名" Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                                            <DataGridTextColumn Header="Unity ID" Binding="{Binding UnityExpressionId, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                                            <DataGridTextColumn Header="Prompt" Binding="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>

                                <Grid Grid.Row="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                                        <TextBlock Text="衣装定義" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                            <Button Content="衣装メッセージへ反映"
                                                    Command="{Binding PopulateOutfitMessagesFromCostumeDefinitionsCommand}"
                                                    MinWidth="150"
                                                    Height="26"
                                                    ToolTip="衣装定義の CostumeId を、選択中ヒロインの未登録の衣装メッセージ項目へ追加します"
                                                    Margin="8,0,0,0"/>
                                            <Button Content="追加"
                                                    Command="{Binding AddCostumeDefinitionCommand}"
                                                    Width="70"
                                                    Height="26"
                                                    Margin="8,0,0,0"/>
                                            <Button Content="削除"
                                                    Command="{Binding RemoveCostumeDefinitionCommand}"
                                                    Width="70"
                                                    Height="26"
                                                    Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <DataGrid Grid.Row="1"
                                              ItemsSource="{Binding CostumeDefinitions}"
                                              SelectedItem="{Binding SelectedCostumeDefinition}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="CostumeId" Binding="{Binding CostumeId, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                                            <DataGridTextColumn Header="表示名" Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                                            <DataGridTextColumn Header="Unity ID" Binding="{Binding UnityCostumeId, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                                            <DataGridTextColumn Header="Prompt" Binding="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>

                                <Grid Grid.Row="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                                        <TextBlock Text="透過レイヤー素材定義" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                            <Button Content="追加"
                                                    Command="{Binding AddLayerAssetDefinitionCommand}"
                                                    Width="70"
                                                    Height="26"
                                                    Margin="8,0,0,0"/>
                                            <Button Content="削除"
                                                    Command="{Binding RemoveLayerAssetDefinitionCommand}"
                                                    Width="70"
                                                    Height="26"
                                                    Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <DataGrid Grid.Row="1"
                                              ItemsSource="{Binding LayerAssetDefinitions}"
                                              SelectedItem="{Binding SelectedLayerAssetDefinition}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="AssetId" Binding="{Binding AssetId, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                                            <DataGridComboBoxColumn Header="種類"
                                                                    SelectedItemBinding="{Binding LayerKind, UpdateSourceTrigger=PropertyChanged}"
                                                                    ItemsSource="{Binding Data.LayerKindOptions, Source={StaticResource ViewModelProxy}}"
                                                                    Width="110"/>
                                            <DataGridComboBoxColumn Header="衣装ID"
                                                                    SelectedItemBinding="{Binding CostumeId, UpdateSourceTrigger=PropertyChanged}"
                                                                    ItemsSource="{Binding Data.CostumeIdOptions, Source={StaticResource ViewModelProxy}}"
                                                                    Width="130"/>
                                            <DataGridComboBoxColumn Header="表情ID"
                                                                    SelectedItemBinding="{Binding ExpressionId, UpdateSourceTrigger=PropertyChanged}"
                                                                    ItemsSource="{Binding Data.ExpressionIdOptions, Source={StaticResource ViewModelProxy}}"
                                                                    Width="130"/>
                                            <DataGridTextColumn Header="表示名" Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                                            <DataGridTextColumn Header="ファイル名" Binding="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" Width="170"/>
                                            <DataGridTextColumn Header="描画順"
                                                                Binding="{Binding DrawOrder, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EmptyStringToIntConverter}}"
                                                                Width="80"/>
                                            <DataGridTextColumn Header="Prompt" Binding="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding DefinitionCatalogValidationMessage}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Height="64"
                                         Foreground="#B00020"
                                         BorderBrush="#E0B4B4"/>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                    <Button Content="Unityレイヤー読込"
                                            Command="{Binding ImportLayeredSpritesFromUnityCommand}"
                                            Width="140"
                                            Height="30"
                                            Margin="0,0,8,0"/>
                                    <Button Content="再読み込み"
                                            Command="{Binding ReloadDefinitionCatalogCommand}"
                                            Width="120"
                                            Height="30"
                                            Margin="0,0,8,0"/>
                                    <Button Content="保存"
                                            Command="{Binding SaveDefinitionCatalogCommand}"
                                            Width="120"
                                            Height="30"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="服装設定">
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="340"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="1" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="服装セット" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
                                    <TextBlock Text="衣装本体と前後アクセサリーを同じ衣装IDへまとめて設定します。空欄のアクセサリーは使用しません。"
                                               Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                    <TextBlock Text="衣装"/>
                                    <ComboBox ItemsSource="{Binding CostumeDefinitions}"
                                              SelectedItem="{Binding SelectedCostumeDefinition}"
                                              DisplayMemberPath="DisplayName"
                                              Height="28" Margin="0,4,0,14"/>

                                    <TextBlock Text="衣装本体画像（CostumeBody）"/>
                                    <ComboBox ItemsSource="{Binding OutfitLayerAssetOptions}"
                                              SelectedItem="{Binding SelectedOutfitCostumeBodyAssetId}"
                                              Height="28" Margin="0,4,0,14"/>

                                    <TextBlock Text="後ろアクセサリー画像（BackAccessory）"/>
                                    <ComboBox ItemsSource="{Binding OutfitLayerAssetOptions}"
                                              SelectedItem="{Binding SelectedOutfitBackAccessoryAssetId}"
                                              Height="28" Margin="0,4,0,14"/>

                                    <TextBlock Text="前アクセサリー画像（FrontAccessory）"/>
                                    <ComboBox ItemsSource="{Binding OutfitLayerAssetOptions}"
                                              SelectedItem="{Binding SelectedOutfitFrontAccessoryAssetId}"
                                              Height="28" Margin="0,4,0,14"/>

                                    <Button Content="前後アクセサリー画像枠を準備"
                                            Command="{Binding AddOutfitAccessoryAssetTemplatesCommand}"
                                            Height="32" Margin="0,4,0,8"/>
                                    <Button Content="服装セットを保存"
                                            Command="{Binding ApplyOutfitCompositionCommand}"
                                            Height="32" Margin="0,4,0,12"/>
                                    <TextBlock Text="{Binding OutfitCompositionMessage}"
                                               Foreground="Gray" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" BorderBrush="#DDDDDD" BorderThickness="1" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="150"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="服装プレビュー" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
                                    <Grid Grid.Row="1" Background="#F7F7F7">
                                        <ItemsControl ItemsSource="{Binding OutfitCompositionPreviewItems}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Grid/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Image Source="{Binding ImagePath, Converter={StaticResource StringToImageSourceConverter}}"
                                                           Stretch="Uniform"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                    <DataGrid Grid.Row="2"
                                              ItemsSource="{Binding OutfitCompositionPreviewItems}"
                                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                              Margin="0,8,0,0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="順" Binding="{Binding DrawOrder}" Width="50"/>
                                            <DataGridTextColumn Header="種類" Binding="{Binding LayerKind}" Width="130"/>
                                            <DataGridTextColumn Header="AssetId" Binding="{Binding AssetId}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="レイヤープレビュー">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="レイヤー画像をDrawOrder順に重ねます。後ろ髪の上へ、選択した表情の顔レイヤーを表示します。保存済みでも未登録の画像は確認用に表示しますが、Export対象にはなりません。"
                                       Foreground="Gray"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="360"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="1" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="組み合わせ" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                        <TextBlock Text="後ろ髪 / 基本身体"/>
                                        <ComboBox ItemsSource="{Binding LayerPreviewBaseBodyOptions}"
                                                  SelectedItem="{Binding SelectedLayerPreviewBaseBodyId}"
                                                  Height="26"
                                                  Margin="0,4,0,12"/>

                                        <TextBlock Text="衣装"/>
                                        <ComboBox ItemsSource="{Binding LayerPreviewCostumeOptions}"
                                                  SelectedItem="{Binding SelectedLayerPreviewCostumeId}"
                                                  Height="26"
                                                  Margin="0,4,0,12"/>

                                        <TextBlock Text="顔レイヤー（表情）"/>
                                        <ComboBox ItemsSource="{Binding LayerPreviewExpressionOptions}"
                                                  SelectedItem="{Binding SelectedLayerPreviewExpressionId}"
                                                  Height="26"
                                                  Margin="0,4,0,12"/>

                                        <Button Content="更新"
                                                Command="{Binding RefreshLayerPreviewCommand}"
                                                Height="30"
                                                Margin="0,4,0,12"/>

                                        <TextBlock Text="{Binding LayerPreviewMessage}"
                                                   Foreground="Gray"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        BorderBrush="#DDDDDD"
                                        BorderThickness="1"
                                        Padding="12">
                                    <Grid Background="#F7F7F7">
                                        <ItemsControl ItemsSource="{Binding LayerPreviewItems}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Grid/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Image Source="{Binding ImagePath, Converter={StaticResource StringToImageSourceConverter}}"
                                                           Stretch="Uniform"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="4" BorderBrush="#DDDDDD" BorderThickness="1" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="表示中レイヤー" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <Grid Grid.Row="1" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="背面へ"
                                                    Command="{Binding MoveLayerPreviewBackwardCommand}" Height="28"/>
                                            <Button Grid.Column="2" Content="前面へ"
                                                    Command="{Binding MoveLayerPreviewForwardCommand}" Height="28"/>
                                        </Grid>
                                        <TextBlock Grid.Row="2"
                                                   Text="順序変更は共通レイヤー定義へ保存され、全キャラクターに適用されます。"
                                                   Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <DataGrid Grid.Row="3"
                                                  ItemsSource="{Binding LayerPreviewItems}"
                                                  SelectedItem="{Binding SelectedLayerPreviewItem}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  CanUserAddRows="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="順" Binding="{Binding DrawOrder}" Width="50"/>
                                                <DataGridTextColumn Header="種類" Binding="{Binding LayerKind}" Width="90"/>
                                                <DataGridTextColumn Header="AssetId" Binding="{Binding AssetId}" Width="150"/>
                                                <DataGridTextColumn Header="表示名" Binding="{Binding DisplayName}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="スチル一覧(確認用)">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="仕様書で常に作成するスチル候補を表形式で確認するための画面です。通常の生成、登録、採用作業はスチル作業タブで行います。"
                                       Foreground="Gray"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>

                            <Button Grid.Row="1"
                                    Content="Prompt に反映"
                                    Command="{Binding ApplyStillPromptCommand}"
                                    Width="140"
                                    Height="28"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,0,8"/>

                            <DataGrid Grid.Row="2"
                                      ItemsSource="{Binding StillDefinitions}"
                                      SelectedItem="{Binding SelectedStillDefinition}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="AssetId" Binding="{Binding AssetId}" Width="150" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="用途" Binding="{Binding Usage}" Width="90" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="表示名" Binding="{Binding DisplayName}" Width="150" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="ファイル名" Binding="{Binding FileName}" Width="170" IsReadOnly="True"/>
                                    <DataGridTemplateColumn Header="状態" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Status}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding DataContext.StillStatuses, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding Status, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="SpecificPrompt"
                                                        Binding="{Binding SpecificPrompt, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="*"/>
                                    <DataGridTextColumn Header="NegativeAddition"
                                                        Binding="{Binding NegativePromptAddition, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="220"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Prompt">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="330"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Grid.ColumnSpan="3"
                                           Text="{Binding SelectedAsset.AssetId, StringFormat=選択中 Asset: {0}}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="テンプレート" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel Grid.Row="1"
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            Margin="0,0,8,0">
                                    <ComboBox ItemsSource="{Binding AssetUsages}"
                                              SelectedItem="{Binding SelectedPromptTemplateUsage}"
                                              Width="120"
                                              Margin="0,0,8,0"/>
                                    <ComboBox ItemsSource="{Binding AvailablePromptTemplates}"
                                              SelectedItem="{Binding SelectedPromptTemplate}"
                                              DisplayMemberPath="DisplayName"
                                              Width="320"/>
                                </StackPanel>
                                <Button Grid.Row="1" Grid.Column="2" Content="適用" Command="{Binding ApplyPromptTemplateCommand}" Height="26"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="ComfyUI" VerticalAlignment="Center" Margin="0,8,8,0"/>
                                <TextBox Grid.Row="2"
                                         Grid.Column="1"
                                         Text="{Binding ComfySettingsSummary}"
                                         IsReadOnly="True"
                                         Margin="0,8,8,0"/>
                                <StackPanel Grid.Row="2"
                                            Grid.Column="2"
                                            Orientation="Horizontal"
                                            Margin="0,8,0,0">
                                    <Button Content="設定再読込"
                                            Command="{Binding ReloadComfySettingsCommand}"
                                            Width="84"
                                            Height="26"
                                            Margin="0,0,4,0"/>
                                    <Button Content="作成"
                                            Command="{Binding BuildComfyWorkflowPreviewCommand}"
                                            Width="52"
                                            Height="26"
                                            Margin="0,0,4,0"/>
                                    <Button Content="テンプレ読込"
                                            Command="{Binding LoadComfyWorkflowTemplateCommand}"
                                            Width="84"
                                            Height="26"
                                            Margin="0,0,4,0"/>
                                    <Button Content="テンプレ保存"
                                            Command="{Binding SaveComfyWorkflowTemplateCommand}"
                                            Width="84"
                                            Height="26"/>
                                </StackPanel>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="positive prompt" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding CurrentPromptRecord.PositivePrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="86" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="negative prompt" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding CurrentPromptRecord.NegativePrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="model" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CurrentPromptRecord.Model, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,8"/>

                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="VAE" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding CurrentPromptRecord.Vae, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="LoRA" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CurrentPromptRecord.Lora, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,8"/>

                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="sampler" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding CurrentPromptRecord.Sampler, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="steps" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CurrentPromptRecord.Steps, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,8"/>

                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="CFG scale" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="4" Grid.Column="3" Text="{Binding CurrentPromptRecord.CfgScale, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="seed" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding CurrentPromptRecord.Seed, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,8"/>

                                    <TextBlock Grid.Row="5" Grid.Column="2" Text="image size" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <StackPanel Grid.Row="5" Grid.Column="3" Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBox Text="{Binding CurrentPromptRecord.ImageWidth, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                        <TextBlock Text=" x " VerticalAlignment="Center" Margin="6,0"/>
                                        <TextBox Text="{Binding CurrentPromptRecord.ImageHeight, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="ControlNet" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding CurrentPromptRecord.ControlNetMemo, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="48" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="upscale" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding CurrentPromptRecord.UpscaleMemo, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="48" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="inpaint / img2img" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding CurrentPromptRecord.InpaintMemo, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="48" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="9" Grid.Column="0" Text="採用理由" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                    <TextBox Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding CurrentPromptRecord.AdoptionReason, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="56" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="10" Grid.Column="0" Text="修正メモ" VerticalAlignment="Top" Margin="0,4,8,0"/>
                                    <TextBox Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding CurrentPromptRecord.RevisionMemo, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="56" TextWrapping="Wrap"/>

                                    <TextBlock Grid.Row="11" Grid.Column="0" Text="Comfy workflow" VerticalAlignment="Top" Margin="0,12,8,0"/>
                                    <TextBox Grid.Row="11"
                                             Grid.Column="1"
                                             Grid.ColumnSpan="3"
                                             Text="{Binding CurrentComfyWorkflowPreview}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             Height="140"
                                             TextWrapping="NoWrap"
                                             HorizontalScrollBarVisibility="Auto"
                                             VerticalScrollBarVisibility="Auto"
                                             Margin="0,8,0,0"/>

                                    <TextBlock Grid.Row="12" Grid.Column="0" Text="workflow template" VerticalAlignment="Top" Margin="0,12,8,0"/>
                                    <TextBox Grid.Row="12"
                                             Grid.Column="1"
                                             Grid.ColumnSpan="3"
                                             Text="{Binding ComfyWorkflowTemplateEditorText, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             Height="220"
                                             TextWrapping="NoWrap"
                                             HorizontalScrollBarVisibility="Auto"
                                             VerticalScrollBarVisibility="Auto"
                                             Margin="0,8,0,0"/>
                                </Grid>
                            </ScrollViewer>

                            <Grid Grid.Row="2" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="320"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="選択中の登録画像（訓練画像を含む）の Prompt を ComfyUI へ送信します。生成後は画像取得してから採用してください。"
                                               Foreground="Gray"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding CurrentComfyResultSummary}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding CurrentComfyPreviewImageMessage}"
                                               Foreground="Gray"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <WrapPanel HorizontalAlignment="Right">
                                        <Button Content="Prompt 保存" Command="{Binding SavePromptRecordCommand}" Width="100" Height="30" Margin="0,0,6,6"/>
                                        <Button Content="選択画像を送信" Command="{Binding SubmitSelectedAssetComfyPromptCommand}" Width="120" Height="30" Margin="0,0,6,6"/>
                                        <Button Content="結果確認" Command="{Binding CheckStillComfyResultCommand}" Width="84" Height="30" Margin="0,0,0,6"/>
                                        <Button Content="待機キャンセル" Command="{Binding CancelStillComfyPollingCommand}" Width="100" Height="30" Margin="0,0,6,0"/>
                                        <Button Content="画像取得" Command="{Binding FetchStillComfyImageCommand}" Width="84" Height="30" Margin="0,0,6,0"/>
                                        <Button Content="選択画像へ採用" Command="{Binding AdoptSelectedAssetComfyImageCommand}" Width="110" Height="30"/>
                                    </WrapPanel>
                                    <Image Source="{Binding CurrentComfyPreviewImagePath, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                           Height="180"
                                           Stretch="Uniform"
                                           Margin="0,8,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="BGM・SE">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="#D5D5D5" BorderThickness="1"
                                    CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Unityプロジェクト"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding UnityProjectPath, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center"
                                             Margin="0,0,8,0"
                                             ToolTip="Assets と ProjectSettings があるUnityプロジェクトのルート"/>
                                    <Button Grid.Column="2" Content="選択"
                                            Command="{Binding BrowseUnityProjectCommand}"
                                            MinWidth="80" Height="28" Margin="0,0,8,0"
                                            ToolTip="ProjectSettings/ProjectVersion.txtを選択します"/>
                                    <Button Grid.Column="3" Content="再走査"
                                            Command="{Binding RefreshAudioLibraryCommand}"
                                            MinWidth="80" Height="28"/>
                                </Grid>
                            </Border>

                            <DockPanel Grid.Row="1" Margin="0,0,0,10">
                                <TextBlock DockPanel.Dock="Bottom"
                                           Text="注意: 登録したBGM・SEとUnityが生成する.metaはテスト素材としてGitへコミットしない運用です。"
                                           Foreground="#A06020" Margin="0,4,0,0"/>
                                <TextBlock DockPanel.Dock="Bottom"
                                           Text="{Binding BgmSeAudioSummary}"
                                           Foreground="#555555" Margin="0,8,0,0"/>
                                <TextBox Text="{Binding BgmSeAudioSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         MinWidth="240"
                                         ToolTip="BGM・SEのIDまたはファイルパスを検索"/>
                            </DockPanel>

                            <StackPanel Grid.Row="2" Orientation="Horizontal"
                                        HorizontalAlignment="Right" Margin="0,0,0,8">
                                <Button Content="BGM・SEを登録"
                                        Command="{Binding RegisterSelectedAudioCommand}"
                                        MinWidth="120" Height="28" Margin="0,0,8,0"
                                        ToolTip="一覧で選択したBGM・SEのIDに音声ファイルをコピーします"/>
                                <Button Content="保存先を開く"
                                        Command="{Binding OpenSelectedAudioFolderCommand}"
                                        MinWidth="110" Height="28" Margin="0,0,8,0"/>
                                <Button Content="選択音声を再生"
                                        Command="{Binding PlaySelectedAudioCommand}"
                                        MinWidth="120" Height="28" Margin="0,0,8,0"/>
                                <Button Content="停止"
                                        Command="{Binding StopAudioPreviewCommand}"
                                        MinWidth="70" Height="28"/>
                            </StackPanel>

                            <DataGrid Grid.Row="3"
                                      ItemsSource="{Binding BgmSeAudioItems}"
                                      SelectedItem="{Binding SelectedAudioLibraryItem}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="状態" Binding="{Binding StatusSymbol}" Width="55"/>
                                    <DataGridTextColumn Header="種類" Binding="{Binding Category}" Width="70"/>
                                    <DataGridTextColumn Header="ID" Binding="{Binding LogicalId}" Width="240"/>
                                    <DataGridTextColumn Header="ファイル" Binding="{Binding FilePath}" Width="*"/>
                                    <DataGridTextColumn Header="期待パス" Binding="{Binding ExpectedPath}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="VOICE">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="#D5D5D5" BorderThickness="1"
                                    CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Unityプロジェクト"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding UnityProjectPath, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Grid.Column="2" Content="選択"
                                            Command="{Binding BrowseUnityProjectCommand}"
                                            MinWidth="80" Height="28" Margin="0,0,8,0"/>
                                    <Button Grid.Column="3" Content="再走査"
                                            Command="{Binding RefreshAudioLibraryCommand}"
                                            MinWidth="80" Height="28"/>
                                </Grid>
                            </Border>
                            <DockPanel Grid.Row="1" Margin="0,0,0,10">
                                <TextBlock DockPanel.Dock="Bottom"
                                           Text="注意: 登録したVOICEとUnityが生成する.metaはテスト素材としてGitへコミットしない運用です。"
                                           Foreground="#A06020" Margin="0,4,0,0"/>
                                <TextBlock DockPanel.Dock="Bottom"
                                           Text="{Binding VoiceAudioSummary}"
                                           Foreground="#555555" Margin="0,8,0,0"/>
                                <CheckBox DockPanel.Dock="Right"
                                          Content="選択中のキャラクターだけ"
                                          IsChecked="{Binding ShowOnlySelectedHeroineAudio}"
                                          VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <CheckBox DockPanel.Dock="Right"
                                          Content="未使用のみ"
                                          IsChecked="{Binding ShowOnlyUnusedVoice}"
                                          VerticalAlignment="Center" Margin="12,0,0,0"
                                          ToolTip="ファイルが存在し、Toolデータ内の参照数が0のVOICEだけを表示します"/>
                                <TextBox Text="{Binding VoiceAudioSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         MinWidth="240"
                                         ToolTip="VOICE IDまたはファイルパスを検索"/>
                            </DockPanel>
                            <Border Grid.Row="2" BorderBrush="#D5D5D5" BorderThickness="1"
                                    CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="VOICE登録:"
                                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedProfile.HeroineId}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="用途"
                                               VerticalAlignment="Center" Margin="8,0,4,0"/>
                                    <ComboBox Grid.Column="3" ItemsSource="{Binding VoiceUsageOptions}"
                                              SelectedItem="{Binding SelectedVoiceUsage}"/>
                                    <TextBlock Grid.Column="4" Text="Voice ID"
                                               VerticalAlignment="Center" Margin="8,0,4,0"/>
                                    <TextBox Grid.Column="5"
                                             Text="{Binding VoiceRegistrationId, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="拡張子なし。例: Line01"/>
                                    <ComboBox Grid.Column="6"
                                              ItemsSource="{Binding VoiceAssignmentTargetOptions}"
                                              SelectedItem="{Binding SelectedVoiceAssignmentTarget}"
                                              Margin="8,0"/>
                                    <Button Grid.Column="7" Content="VOICEを登録"
                                            Command="{Binding RegisterVoiceCommand}"
                                            MinWidth="105" Height="28" Margin="0,0,8,0"/>
                                    <Button Grid.Column="8" Content="保存先を開く"
                                            Command="{Binding OpenVoiceFolderCommand}"
                                            MinWidth="100" Height="28"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Row="3" Orientation="Horizontal"
                                        HorizontalAlignment="Right" Margin="0,0,0,8">
                                <Button Content="選択VOICEの保存先"
                                        Command="{Binding OpenSelectedVoiceFolderCommand}"
                                        MinWidth="130" Height="28" Margin="0,0,8,0"/>
                                <Button Content="選択音声を再生"
                                        Command="{Binding PlaySelectedAudioCommand}"
                                        MinWidth="120" Height="28" Margin="0,0,8,0"/>
                                <Button Content="停止"
                                        Command="{Binding StopAudioPreviewCommand}"
                                        MinWidth="70" Height="28"/>
                            </StackPanel>
                            <DataGrid Grid.Row="4"
                                      ItemsSource="{Binding VoiceAudioItems}"
                                      SelectedItem="{Binding SelectedAudioLibraryItem}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="状態" Binding="{Binding VoiceStatusSymbol}" Width="55">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="ToolTip" Value="{Binding VoiceStatusToolTip}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="判定" Binding="{Binding VoiceStatusText}" Width="70"/>
                                    <DataGridTextColumn Header="Voice ID" Binding="{Binding LogicalId}" Width="260"/>
                                    <DataGridTextColumn Header="キャラクター" Binding="{Binding HeroineId}" Width="130"/>
                                    <DataGridTextColumn Header="参照数" Binding="{Binding ReferenceText}" Width="70"/>
                                    <DataGridTextColumn Header="参照元" Binding="{Binding ReferenceDetails}" Width="220"/>
                                    <DataGridTextColumn Header="ファイル" Binding="{Binding FilePath}" Width="*"/>
                                    <DataGridTextColumn Header="期待パス" Binding="{Binding ExpectedPath}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="制作状況">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Content="再集計"
                                        Command="{Binding RefreshProductionStatusCommand}"
                                        Width="90" Height="28"/>
                                <CheckBox Content="未完成のみ表示"
                                          IsChecked="{Binding ShowOnlyIncompleteProductionStatus}"
                                          VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedProfile.DisplayName, StringFormat=選択中: \{0\}}"
                                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </DockPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ProductionStatusCategories}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#D5D5D5" BorderThickness="1" CornerRadius="4"
                                                    Padding="10" Margin="0,0,0,10" Background="#FAFAFA">
                                                <StackPanel>
                                                    <Button Command="{Binding Data.OpenProductionStatusTargetCommand, Source={StaticResource ViewModelProxy}}"
                                                            CommandParameter="{Binding}" ToolTip="クリックすると編集画面へ移動します"
                                                            HorizontalContentAlignment="Left" Padding="8,5">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Symbol}" FontSize="20" FontWeight="Bold" Width="34"/>
                                                            <TextBlock Text="{Binding CategoryName}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <TextBlock Text="{Binding Details}" TextWrapping="Wrap" Margin="8,8,8,6"/>
                                                    <ItemsControl ItemsSource="{Binding Checks}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Command="{Binding Data.OpenProductionStatusTargetCommand, Source={StaticResource ViewModelProxy}}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip="{Binding Details}" HorizontalContentAlignment="Left"
                                                                        Margin="8,2" Padding="6,3">
                                                                    <DockPanel>
                                                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Symbol}" FontWeight="Bold" Width="28"/>
                                                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                                                                    </DockPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Export">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="出力先" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ExportPath, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="2"
                                       Text="Accepted の画像、対応する prompt JSON、Data 下書き Markdown を Unity 取り込み用に出力します。"
                                       Foreground="Gray"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>

                            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding LastExportReport.AcceptedAssetCount, StringFormat=Accepted: \{0\}}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LastExportReport.ExportedImageCount, StringFormat=Images: \{0\}}"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding LastExportReport.ExportedPromptCount, StringFormat=Prompts: \{0\}}"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding LastExportReport.SkippedImageCount, StringFormat=Skipped: \{0\}}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding LastExportReport.ConversationCount, StringFormat=Conversations: \{0\}}" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LastExportReport.GameEventCount, StringFormat=Events: \{0\}}" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding LastExportReport.ScheduledEventCount, StringFormat=Scheduled: \{0\}}" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding LastExportReport.ActionReactionCount, StringFormat=Reactions: \{0\}}" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding LastExportReport.EndingCount, StringFormat=Endings: \{0\}}" Margin="0,4,0,0"/>
                            </Grid>

                            <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Export 対象 (Accepted のみ)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="警告" FontWeight="SemiBold" Margin="0,0,0,8"/>

                                <DataGrid Grid.Row="1"
                                          Grid.Column="0"
                                          ItemsSource="{Binding AcceptedAssets}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="AssetId" Binding="{Binding AssetId}" Width="140"/>
                                        <DataGridTextColumn Header="用途" Binding="{Binding Usage}" Width="90"/>
                                        <DataGridTextColumn Header="状態" Binding="{Binding Status}" Width="90"/>
                                        <DataGridTextColumn Header="ファイル名" Binding="{Binding FileName}" Width="160"/>
                                        <DataGridTextColumn Header="Prompt" Binding="{Binding PromptRecordPath}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <ListBox Grid.Row="1"
                                         Grid.Column="2"
                                         ItemsSource="{Binding LastExportReport.Warnings}"/>
                            </Grid>

                            <StackPanel Grid.Row="4"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,12,0,0">
                                <Button Content="出力先を開く"
                                        Command="{Binding OpenExportDirectoryCommand}"
                                        Width="120"
                                        Height="30"
                                        Margin="0,0,8,0"/>
                                <Button Content="Export 実行"
                                        Command="{Binding ExportSelectedProfileCommand}"
                                        Width="140"
                                        Height="30"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                </TabControl>
            </Border>
        </Grid>

        <!--<DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="戦闘メッセージへ"
                    Command="{Binding OpenBattleMessagesTabCommand}"
                    Width="130" Height="28" Margin="8,0,0,0"/>
            <TextBox Text="{Binding StatusMessage}" Foreground="#444444" IsReadOnly="True" />
        </DockPanel>-->
    </Grid>
</Window>
