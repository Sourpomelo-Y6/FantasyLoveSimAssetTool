                                                             AcceptsReturn="True" TextWrapping="Wrap" MaxLength="400"
                                                             MinHeight="64" Margin="0,3,0,10"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="12"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="口調ルール（1行1件・最大8件）"/>
                                                            <TextBox Text="{Binding ConversationCharacterVoiceRulesText, UpdateSourceTrigger=PropertyChanged}"
                                                                     AcceptsReturn="True" TextWrapping="Wrap" Height="110"
                                                                     VerticalScrollBarVisibility="Auto" Margin="0,3,0,10"/>
                                                            <TextBlock Text="感情表現ルール（1行1件・最大8件）"/>
                                                            <TextBox Text="{Binding ConversationCharacterEmotionRulesText, UpdateSourceTrigger=PropertyChanged}"
                                                                     AcceptsReturn="True" TextWrapping="Wrap" Height="110"
                                                                     VerticalScrollBarVisibility="Auto" Margin="0,3,0,10"/>
                                                            <TextBlock Text="参考台詞（1行1件・最大3件）"/>
                                                            <TextBox Text="{Binding ConversationCharacterReferenceLinesText, UpdateSourceTrigger=PropertyChanged}"
                                                                     AcceptsReturn="True" TextWrapping="Wrap" Height="110"
                                                                     VerticalScrollBarVisibility="Auto" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="関係性ルール（1行1件・最大8件）"/>
                                                            <TextBox Text="{Binding ConversationCharacterRelationshipRulesText, UpdateSourceTrigger=PropertyChanged}"
                                                                     AcceptsReturn="True" TextWrapping="Wrap" Height="110"
                                                                     VerticalScrollBarVisibility="Auto" Margin="0,3,0,10"/>
                                                            <TextBlock Text="禁止表現（1行1件・最大8件）"/>
                                                            <TextBox Text="{Binding ConversationCharacterAvoidExpressionsText, UpdateSourceTrigger=PropertyChanged}"
                                                                     AcceptsReturn="True" TextWrapping="Wrap" Height="110"
                                                                     VerticalScrollBarVisibility="Auto" Margin="0,3,0,10"/>
                                                            <TextBlock Text="生成に使う固有指示プレビュー"/>
                                                            <TextBox Text="{Binding ConversationCharacterPromptPreview, Mode=OneWay}"
                                                                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                                                     Height="110" VerticalScrollBarVisibility="Auto" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                            <WrapPanel HorizontalAlignment="Right" Margin="0,12,0,0">
