                                              ItemsSource="{Binding FilteredConversationEntries}"
                                              SelectedItem="{Binding SelectedConversationEntry}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="140"/>
                                            <DataGridTextColumn Header="タイトル" Binding="{Binding Title}" Width="180"/>
                                            <DataGridTextColumn Header="カテゴリ" Binding="{Binding Category}" Width="120"/>
                                            <DataGridTextColumn Header="優先度" Binding="{Binding Priority}" Width="70"/>
                                            <DataGridTextColumn Header="候補" Binding="{Binding TriggerCandidateText}" Width="70" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="警告" Binding="{Binding ValidationWarningText}" Width="180" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="先頭行" Binding="{Binding FirstLinePreview}" Width="*" IsReadOnly="True"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>

                                <TabControl Grid.Column="2">
                                    <TabItem Header="通常台詞">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <Grid Margin="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Id" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                        <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding SelectedConversationEntry.Id, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                                            <Button Grid.Column="1" Content="ID生成" Command="{Binding GenerateConversationIdCommand}" Height="26"/>
                                        </Grid>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="タイトル" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedConversationEntry.Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="カテゴリ" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                        <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding SelectedConversationEntry.Category, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding ConversationCategorySuggestions}"
                                                      SelectedItem="{Binding SelectedConversationCategorySuggestion}"
                                                      Height="26"
                                                      Margin="0,0,8,0"/>
                                            <Button Grid.Column="2" Content="反映" Command="{Binding ApplyConversationCategorySuggestionCommand}" Height="26"/>
                                            <Button Grid.Column="3"
                                                    Content="雛形"
                                                    Command="{Binding ApplyConversationEventTemplateCommand}"
                                                    Height="26"
                                                    Margin="8,0,0,0"/>
                                        </Grid>

                                        <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="台詞行" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,220,0">
                                                <ComboBox ItemsSource="{Binding ConversationExpressionSuggestions}"
                                                          SelectedItem="{Binding SelectedConversationExpressionSuggestion}"
                                                          Width="120"
                                                          Height="26"
                                                          Margin="0,0,8,0"/>
                                                <Button Content="表情反映" Command="{Binding ApplyConversationExpressionSuggestionCommand}" Height="26" Width="80"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="行追加" Command="{Binding AddConversationLineCommand}" Height="26" Margin="0,0,8,0"/>
                                            <Button Grid.Column="2" Content="行削除" Command="{Binding RemoveConversationLineCommand}" Height="26"/>
                                        </Grid>

                                        <DataGrid Grid.Row="4"
                                                  Grid.Column="0"
                                                  Grid.ColumnSpan="2"
                                                  ItemsSource="{Binding SelectedConversationEntry.Lines}"
                                                  SelectedItem="{Binding SelectedConversationLine}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  MinHeight="220"
                                                  Margin="0,0,0,8">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="話者" Binding="{Binding Speaker}" Width="100"/>
                                                <DataGridTextColumn Header="表情" Binding="{Binding Expression}" Width="100"/>
                                                <DataGridTemplateColumn Header="Voice ID" Width="190">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <ComboBox ItemsSource="{Binding Data.AvailableVoiceIds, Source={StaticResource ViewModelProxy}}"
                                                                      Text="{Binding VoiceId, UpdateSourceTrigger=PropertyChanged}"
                                                                      IsEditable="True"
                                                                      ToolTip="VOICEタブで検出したIDから選択。直接入力も可能です"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="本文" Binding="{Binding Text}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <Expander Grid.Row="5"
                                                  Grid.Column="0"
                                                  Grid.ColumnSpan="2"
                                                  Header="選択中の台詞をAIで入力補助"
                                                  Margin="0,4,0,8">
                                            <StackPanel Margin="0,8,0,0">
                                                <Border Background="#F7F4F8"
                                                        BorderBrush="#D3C3D8"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="12"
                                                        Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="120"/>
                                                                <ColumnDefinition Width="100"/>
                                                                <ColumnDefinition Width="250"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="状況テンプレート" VerticalAlignment="Center"/>
                                                            <ComboBox Grid.Column="1"
                                                                      ItemsSource="{Binding ConversationSituationTypeFilters}"
                                                                      SelectedItem="{Binding SelectedConversationSituationTypeFilter}"
                                                                      Height="26"
                                                                      Margin="0,0,8,0"/>
                                                            <ComboBox Grid.Column="2"
                                                                      ItemsSource="{Binding FilteredConversationSituationPrompts}"
                                                                      SelectedItem="{Binding SelectedConversationSituationPrompt}"
                                                                      DisplayMemberPath="DisplayName"
                                                                      Height="26"
                                                                      Margin="0,0,8,0">
                                                                <ComboBox.ItemContainerStyle>
                                                                    <Style TargetType="{x:Type ComboBoxItem}">
                                                                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                                    </Style>
                                                                </ComboBox.ItemContainerStyle>
                                                            </ComboBox>
                                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,12,0">
                                                                <Button Content="この状況で新規会話を準備"
                                                                        Command="{Binding PrepareConversationFromSituationCommand}"
                                                                        Height="26"
                                                                        Padding="10,2"
                                                                        Margin="0,0,8,0"/>
                                                                <Button Content="使用しない"
                                                                        Command="{Binding ClearConversationSituationPromptCommand}"
                                                                        Height="26"
                                                                        Padding="10,2"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="4"
                                                                       Text="{Binding ConversationCharacterPromptStatus}"
                                                                       Foreground="#66606A"
                                                                       VerticalAlignment="Center"
                                                                       TextWrapping="Wrap"/>
                                                        </Grid>
                                                        <Expander Header="使用するキャラクター固有指示を確認" Margin="0,8,0,0">
                                                            <StackPanel Margin="0,8,0,0">
                                                                <TextBlock Text="{Binding ConversationCharacterPromptEditStatus}"
                                                                           Foreground="#765D24" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                                <TextBox Text="{Binding ConversationCharacterPromptPreview, Mode=OneWay}"
                                                                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                                                         Height="120" VerticalScrollBarVisibility="Auto"/>
                                                                <Button Content="基本情報の会話AI設定を編集"
                                                                        Command="{Binding OpenConversationCharacterPromptEditorCommand}"
                                                                        HorizontalAlignment="Right" Padding="12,4" Margin="0,8,0,0"/>
                                                            </StackPanel>
                                                        </Expander>
                                                        <Border Background="#FFFDF4"
                                                                BorderBrush="#D8C98F"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="8"
                                                                Margin="0,8,0,0">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="推奨条件" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,3,8,0"/>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding ConversationSuggestedConditionsPreview}"
                                                                           TextWrapping="Wrap"
                                                                           Foreground="#665D3C"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,12,0"/>
                                                                <Button Grid.Column="2"
                                                                        Content="推奨条件を反映"
                                                                        Command="{Binding ApplyConversationSituationConditionsCommand}"
                                                                        Height="28"
                                                                        Padding="12,2"
                                                                        VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>
                                                        <Grid Margin="0,8,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="120"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="今回の追加指示" VerticalAlignment="Top" Margin="0,4,8,0"/>
                                                            <TextBox Grid.Column="1"
                                                                     Text="{Binding ConversationAdditionalInstruction, UpdateSourceTrigger=PropertyChanged}"
                                                                     AcceptsReturn="True"
                                                                     TextWrapping="Wrap"
                                                                     MinHeight="54"
                                                                     MaxLength="500"/>
                                                        </Grid>
                                                        <Expander Header="合成された追加プロンプトを確認" Margin="0,8,0,0">
                                                            <TextBox Text="{Binding ConversationAdditionalPromptPreview, Mode=OneWay}"
                                                                     IsReadOnly="True"
                                                                     AcceptsReturn="True"
                                                                     TextWrapping="Wrap"
                                                                     Height="180"
                                                                     Margin="0,8,0,0"
                                                                     VerticalScrollBarVisibility="Auto"/>
                                                        </Expander>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#F4F7FA"
                                                        BorderBrush="#9FB8CC"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="12"
                                                        Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="複数行の会話下書き" FontWeight="SemiBold" FontSize="14"/>
                                                                <TextBlock Text="選択中の会話項目に対して、最大3行の下書きを1案生成します。条件やIDは変更しません。"
                                                                           Foreground="#596875" TextWrapping="Wrap" Margin="0,2,12,0"/>
                                                            </StackPanel>
                                                            <WrapPanel Grid.Column="1">
                                                                <Button Content="下書きを生成 / 再生成"
                                                                        Command="{Binding GenerateConversationDraftCommand}"
                                                                        Padding="12,6" Margin="0,0,6,0"/>
                                                                <Button Content="キャンセル"
                                                                        Command="{Binding CancelConversationDraftCommand}"
                                                                        Padding="12,6"/>
                                                            </WrapPanel>
                                                        </Grid>
                                                        <TextBox Text="{Binding ConversationDraftStatus, Mode=OneWay}"
                                                                 IsReadOnly="True" TextWrapping="Wrap" MinHeight="36"
                                                                 Margin="0,8,0,8"/>
                                                        <DataGrid ItemsSource="{Binding ConversationDraftLines}"
                                                                  AutoGenerateColumns="False"
                                                                  CanUserAddRows="False"
                                                                  IsReadOnly="True"
                                                                  MinHeight="110"
                                                                  MaxHeight="210">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="話者" Binding="{Binding Speaker}" Width="100"/>
                                                                <DataGridTextColumn Header="表情" Binding="{Binding ExpressionId}" Width="110"/>
                                                                <DataGridTextColumn Header="本文" Binding="{Binding Text}" Width="*"/>
                                                                <DataGridTextColumn Header="品質警告" Binding="{Binding WarningText}" Width="220"/>
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                                            <Button Content="既存行へ追加"
                                                                    Command="{Binding AppendConversationDraftCommand}"
                                                                    Padding="12,6" Margin="0,0,8,0"/>
                                                            <Button Content="既存行と置き換え"
                                                                    Command="{Binding ReplaceConversationDraftCommand}"
                                                                    Padding="12,6"/>
                                                        </StackPanel>
                                                        <Expander Header="下書き用プロンプト・生レスポンス" Margin="0,8,0,0">
                                                            <Grid Margin="0,8,0,0">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition/>
                                                                    <RowDefinition/>
                                                                </Grid.RowDefinitions>
                                                                <TextBox Text="{Binding ConversationDraftPrompt, Mode=OneWay}"
                                                                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                                                         Height="130" VerticalScrollBarVisibility="Auto"/>
                                                                <TextBox Grid.Row="1"
                                                                         Text="{Binding ConversationDraftRawResponse, Mode=OneWay}"
                                                                         IsReadOnly="True" AcceptsReturn="True"
                                                                         Height="110" FontFamily="Consolas" FontSize="11"
                                                                         HorizontalScrollBarVisibility="Auto"
                                                                         VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"/>
                                                            </Grid>
                                                        </Expander>
                                                    </StackPanel>
                                                </Border>
                                                <local:LocalAiShortTextPanel TargetGroup="ConversationLine"/>
                                            </StackPanel>
                                        </Expander>

                                            </Grid>
                                        </ScrollViewer>
                                    </TabItem>

                                    <TabItem Header="選択肢・分岐">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <Grid Margin="8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="100"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="選択肢と分岐" FontWeight="SemiBold" FontSize="14"/>
                                                        <TextBlock Text="選択肢の表示文、返答、好感度変化を編集します。"
                                                                   Foreground="Gray"
                                                                   Margin="0,3,8,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Content="選択肢追加"
                                                            Command="{Binding AddConversationChoiceCommand}"
                                                            Height="26"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Top"/>
                                                    <Button Grid.Column="2"
                                                            Content="選択肢削除"
                                                            Command="{Binding RemoveConversationChoiceCommand}"
                                                            Height="26"
                                                            VerticalAlignment="Top"/>
                                                </Grid>

                                                <DataGrid Grid.Row="1"
                                                          ItemsSource="{Binding SelectedConversationEntry.Choices}"
                                                          SelectedItem="{Binding SelectedConversationChoice}"
                                                          AutoGenerateColumns="False"
                                                          CanUserAddRows="False"
                                                          MinHeight="240"
                                                          Margin="0,0,0,8">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="選択肢" Binding="{Binding ChoiceText}" Width="2*"/>
                                                        <DataGridTextColumn Header="返答" Binding="{Binding ResponseText}" Width="3*"/>
                                                        <DataGridTextColumn Header="好感度" Binding="{Binding AffectionChange}" Width="80"/>
                                                        <DataGridTextColumn Header="警告" Binding="{Binding ValidationWarningText}" Width="220" IsReadOnly="True"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>

                                                <Border Grid.Row="2"
                                                        BorderBrush="#D8D8D8"
                                                        BorderThickness="1"
                                                        CornerRadius="3"
                                                        Padding="10"
                                                        Margin="0,4,0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                                                   Text="選択中の選択肢"
                                                                   FontWeight="SemiBold" FontSize="14"
                                                                   Margin="0,0,0,8"/>
                                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                                   Text="プレイヤー選択肢"
                                                                   VerticalAlignment="Top" Margin="0,5,8,8"/>
                                                        <TextBox Grid.Row="1" Grid.Column="1"
                                                                 Text="{Binding SelectedConversationChoice.ChoiceText, UpdateSourceTrigger=PropertyChanged}"
                                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                                 MinHeight="58" VerticalScrollBarVisibility="Auto"
                                                                 Margin="0,0,0,8"/>
                                                        <TextBlock Grid.Row="2" Grid.Column="0"
                                                                   Text="ヒロインの返答"
                                                                   VerticalAlignment="Top" Margin="0,5,8,8"/>
                                                        <TextBox Grid.Row="2" Grid.Column="1"
                                                                 Text="{Binding SelectedConversationChoice.ResponseText, UpdateSourceTrigger=PropertyChanged}"
                                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                                 MinHeight="82" VerticalScrollBarVisibility="Auto"
                                                                 Margin="0,0,0,8"/>
                                                        <TextBlock Grid.Row="3" Grid.Column="0"
                                                                   Text="好感度変化"
                                                                   VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                        <TextBox Grid.Row="3" Grid.Column="1"
                                                                 Text="{Binding SelectedConversationChoice.AffectionChange, UpdateSourceTrigger=LostFocus}"
                                                                 Width="100" HorizontalAlignment="Left"
                                                                 Margin="0,0,0,8"/>
                                                        <TextBlock Grid.Row="4" Grid.Column="0"
                                                                   Text="警告"
                                                                   VerticalAlignment="Top" Margin="0,5,8,0"/>
                                                        <TextBox Grid.Row="4" Grid.Column="1"
                                                                 Text="{Binding SelectedConversationChoice.ValidationWarningText, Mode=OneWay}"
                                                                 IsReadOnly="True" TextWrapping="Wrap"
                                                                 MinHeight="34"/>
                                                    </Grid>
                                                </Border>

                                                <Expander Grid.Row="3"
                                                          IsExpanded="False"
                                                          Margin="0,4,0,0">
                                                    <Expander.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="プレイヤー選択肢AI" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding ConversationChoiceCandidates.Count, StringFormat=候補 {0}件}"
                                                                       Foreground="Gray" Margin="12,0,0,0"/>
                                                            <TextBlock Text="{Binding ConversationChoiceAiStatus}"
                                                                       Foreground="Gray" Margin="12,0,0,0"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                                                        </StackPanel>
                                                    </Expander.Header>
                                                    <StackPanel Margin="8">
                                                        <TextBlock Text="選択中の会話の最後の台詞を文脈にし、選択肢の表示文だけを生成します。返答・好感度・分岐設定は変更しません。"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="Gray"
                                                                   Margin="0,0,0,8"/>
                                                        <WrapPanel Margin="0,0,0,8">
                                                            <TextBlock Text="方向性" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                            <ComboBox ItemsSource="{Binding ConversationChoiceDirections}"
                                                                      SelectedItem="{Binding SelectedConversationChoiceDirection}"
                                                                      Width="120" Height="26" Margin="0,0,8,0"/>
                                                            <Button Content="3案を生成"
                                                                    Command="{Binding GenerateConversationChoiceCandidatesCommand}"
                                                                    Height="26" Padding="12,2" Margin="0,0,8,0"/>
                                                            <Button Content="キャンセル"
                                                                    Command="{Binding CancelConversationChoiceGenerationCommand}"
                                                                    Height="26" Padding="12,2"/>
                                                        </WrapPanel>
                                                        <TextBlock Text="追加プロンプト（任意）" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                        <TextBox Text="{Binding ConversationChoiceAdditionalInstruction, UpdateSourceTrigger=PropertyChanged}"
                                                                 AcceptsReturn="True"
                                                                 TextWrapping="Wrap"
                                                                 MinHeight="58"
                                                                 VerticalScrollBarVisibility="Auto"
                                                                 ToolTip="例: 森、安全を優先 / 入力した文章をプレイヤーの自然な選択肢へ添削"
                                                                 Margin="0,0,0,4"/>
                                                        <TextBlock Text="キーワードは候補の内容へ反映し、文章は意図を保ったプレイヤー選択肢へ添削します。"
                                                                   Foreground="Gray" FontSize="11" TextWrapping="Wrap"
                                                                   Margin="0,0,0,8"/>
                                                        <TextBox Text="{Binding ConversationChoiceAiStatus, Mode=OneWay}"
                                                                 IsReadOnly="True" TextWrapping="Wrap"
                                                                 MinHeight="34" Margin="0,0,0,8"/>
                                                        <ItemsControl ItemsSource="{Binding ConversationChoiceCandidates}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border BorderBrush="#D8D8D8" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,6">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                                                                <TextBlock Text="{Binding ValidationMessage}"
                                                                                           Foreground="#A06020" FontSize="11" Margin="0,3,0,0"/>
                                                                            </StackPanel>
                                                                            <Button Grid.Column="1" Content="この案を反映"
                                                                                    Command="{Binding DataContext.AdoptConversationChoiceCandidateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                    CommandParameter="{Binding}"
                                                                                    Height="26" Padding="10,2" Margin="12,0,0,0"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <Expander Header="プロンプト・生レスポンス" Margin="0,4,0,0">
                                                            <Grid Margin="0,8,0,0">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition/>
                                                                    <RowDefinition/>
                                                                </Grid.RowDefinitions>
                                                                <TextBox Text="{Binding ConversationChoiceAiPrompt, Mode=OneWay}"
                                                                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                                                         Height="120" VerticalScrollBarVisibility="Auto"/>
                                                                <TextBox Grid.Row="1" Text="{Binding ConversationChoiceAiRawResponse, Mode=OneWay}"
                                                                         IsReadOnly="True" AcceptsReturn="True"
                                                                         Height="100" FontFamily="Consolas" FontSize="11"
                                                                         HorizontalScrollBarVisibility="Auto"
                                                                         VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"/>
                                                            </Grid>
                                                        </Expander>
                                                    </StackPanel>
                                                </Expander>

                                                <Expander Grid.Row="4"
                                                          IsExpanded="False"
                                                          Margin="0,8,0,0">
                                                    <Expander.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="ヒロイン返答AI" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding ConversationChoiceResponseCandidates.Count, StringFormat=候補 {0}件}"
                                                                       Foreground="Gray" Margin="12,0,0,0"/>
                                                            <TextBlock Text="{Binding ConversationChoiceResponseAiStatus}"
                                                                       Foreground="Gray" Margin="12,0,0,0"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                                                        </StackPanel>
                                                    </Expander.Header>
                                                    <StackPanel Margin="8">
                                                        <TextBlock Text="選択中のプレイヤー選択肢を必須の文脈として、ヒロインの返答だけを生成します。選択肢文言や好感度は変更しません。"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="Gray"
                                                                   Margin="0,0,0,8"/>
                                                        <WrapPanel Margin="0,0,0,8">
                                                            <Button Content="返答を3案生成"
                                                                    Command="{Binding GenerateConversationChoiceResponseCandidatesCommand}"
                                                                    Height="26" Padding="12,2" Margin="0,0,8,0"/>
                                                            <Button Content="キャンセル"
                                                                    Command="{Binding CancelConversationChoiceResponseGenerationCommand}"
                                                                    Height="26" Padding="12,2"/>
                                                        </WrapPanel>
                                                        <TextBlock Text="追加プロンプト（任意）" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                        <TextBox Text="{Binding ConversationChoiceResponseAdditionalInstruction, UpdateSourceTrigger=PropertyChanged}"
                                                                 AcceptsReturn="True"
                                                                 TextWrapping="Wrap"
                                                                 MinHeight="58"
                                                                 VerticalScrollBarVisibility="Auto"
                                                                 ToolTip="例: 少し照れながら / 誘いを断るが嬉しそうにする / 入力した返答案をキャラクターらしく添削"
                                                                 Margin="0,0,0,4"/>
                                                        <TextBlock Text="感情・反応方針・キーワードを反映し、文章はキャラクターらしい返答へ添削します。"
                                                                   Foreground="Gray" FontSize="11" TextWrapping="Wrap"
                                                                   Margin="0,0,0,8"/>
                                                        <TextBox Text="{Binding ConversationChoiceResponseAiStatus, Mode=OneWay}"
                                                                 IsReadOnly="True" TextWrapping="Wrap"
                                                                 MinHeight="34" Margin="0,0,0,8"/>
                                                        <ItemsControl ItemsSource="{Binding ConversationChoiceResponseCandidates}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border BorderBrush="#D8D8D8" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,6">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                                                                <TextBlock Text="{Binding ValidationMessage}"
                                                                                           Foreground="#A06020" FontSize="11" Margin="0,3,0,0"/>
                                                                            </StackPanel>
                                                                            <Button Grid.Column="1" Content="この返答を反映"
                                                                                    Command="{Binding DataContext.AdoptConversationChoiceResponseCandidateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                    CommandParameter="{Binding}"
                                                                                    Height="26" Padding="10,2" Margin="12,0,0,0"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <Expander Header="プロンプト・生レスポンス" Margin="0,4,0,0">
                                                            <Grid Margin="0,8,0,0">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition/>
                                                                    <RowDefinition/>
                                                                </Grid.RowDefinitions>
                                                                <TextBox Text="{Binding ConversationChoiceResponseAiPrompt, Mode=OneWay}"
                                                                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                                                         Height="120" VerticalScrollBarVisibility="Auto"/>
                                                                <TextBox Grid.Row="1" Text="{Binding ConversationChoiceResponseAiRawResponse, Mode=OneWay}"
                                                                         IsReadOnly="True" AcceptsReturn="True"
                                                                         Height="100" FontFamily="Consolas" FontSize="11"
                                                                         HorizontalScrollBarVisibility="Auto"
                                                                         VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"/>
                                                            </Grid>
                                                        </Expander>
                                                    </StackPanel>
                                                </Expander>
                                            </Grid>
                                        </ScrollViewer>
                                    </TabItem>

                                    <TabItem Header="条件・演出">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel Margin="8">
                                                <Expander Header="発生条件"
                                                          IsExpanded="True"
                                                          Margin="0,0,0,8">
                                                    <Grid Margin="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="場所/イベント発火" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                <WrapPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                                                    <TextBox Text="{Binding SelectedConversationEntry.Conditions.LocationId, UpdateSourceTrigger=PropertyChanged}" Width="180" ToolTip="場所条件" Margin="0,0,8,0"/>
                                                    <TextBlock Text="発火種類" VerticalAlignment="Center" Margin="8,0"/>
                                                    <TextBox Text="{Binding SelectedConversationEntry.Conditions.GameEventTriggerType, UpdateSourceTrigger=PropertyChanged}" Width="190" ToolTip="例: ScheduledEventCompleted" Margin="0,0,8,0"/>
                                                    <TextBlock Text="対象ID" VerticalAlignment="Center" Margin="8,0"/>
                                                    <TextBox Text="{Binding SelectedConversationEntry.Conditions.TriggerContextId, UpdateSourceTrigger=PropertyChanged}" Width="140" ToolTip="例: Forest"/>
                                                </WrapPanel>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="好感度" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                <WrapPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                                                    <TextBox Text="{Binding SelectedConversationEntry.Conditions.MinAffection, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                                    <TextBlock Text=" - " VerticalAlignment="Center" Margin="8,0"/>
                                                    <TextBox Text="{Binding SelectedConversationEntry.Conditions.MaxAffection, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                                    <CheckBox Content="一度だけ" IsChecked="{Binding SelectedConversationEntry.Conditions.Once}" VerticalAlignment="Center" Margin="24,0,0,0"/>
                                                    <TextBlock Text="イベント完了時変化" VerticalAlignment="Center" Margin="24,0,8,0"/>
                                                    <TextBox Text="{Binding SelectedConversationEntry.AffectionChange, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                                </WrapPanel>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="天候/季節/時間" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                <WrapPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                                                    <TextBox Text="{Binding SelectedConversationEntry.Conditions.Weather, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,8,0"/>
                                                    <TextBox Text="{Binding SelectedConversationEntry.Conditions.Season, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,8,0"/>
                                                    <TextBox Text="{Binding SelectedConversationEntry.Conditions.TimeOfDay, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,16,0"/>
                                                    <ComboBox ItemsSource="{Binding ConversationWeatherSuggestions}" SelectedItem="{Binding SelectedConversationWeatherSuggestion}" Width="105" Height="26" Margin="0,0,8,0"/>
                                                    <ComboBox ItemsSource="{Binding ConversationSeasonSuggestions}" SelectedItem="{Binding SelectedConversationSeasonSuggestion}" Width="105" Height="26" Margin="0,0,8,0"/>
                                                    <ComboBox ItemsSource="{Binding ConversationTimeOfDaySuggestions}" SelectedItem="{Binding SelectedConversationTimeOfDaySuggestion}" Width="105" Height="26" Margin="0,0,8,0"/>
                                                    <Button Content="候補反映" Command="{Binding ApplyConversationConditionSuggestionsCommand}" Height="26" Width="80"/>
                                                </WrapPanel>

                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="行動/必要Item" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                <WrapPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,8">
                                                    <TextBox Text="{Binding SelectedConversationEntry.Conditions.ActionId, UpdateSourceTrigger=PropertyChanged}" Width="180" Margin="0,0,8,0"/>
                                                    <TextBox Text="{Binding SelectedConversationEntry.Conditions.RequiredItemId, UpdateSourceTrigger=PropertyChanged}" Width="180" Margin="0,0,16,0"/>
                                                    <ComboBox ItemsSource="{Binding ConversationActionSuggestions}" SelectedItem="{Binding SelectedConversationActionSuggestion}" Width="140" Height="26" Margin="0,0,8,0"/>
                                                    <ComboBox ItemsSource="{Binding ConversationLocationSuggestions}" SelectedItem="{Binding SelectedConversationLocationSuggestion}" Width="140" Height="26" Margin="0,0,8,0"/>
                                                    <Button Content="候補反映" Command="{Binding ApplyConversationConditionSuggestionsCommand}" Height="26" Width="80"/>
                                                </WrapPanel>

                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="衣装" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                <WrapPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,8">
                                                    <TextBox Text="{Binding SelectedConversationEntry.Conditions.CostumeId, UpdateSourceTrigger=PropertyChanged}" Width="180" Margin="0,0,8,0"/>
                                                    <ComboBox ItemsSource="{Binding ConversationCostumeSuggestions}" SelectedItem="{Binding SelectedConversationCostumeSuggestion}" Width="140" Height="26" Margin="0,0,8,0"/>
                                                    <Button Content="候補反映" Command="{Binding ApplyConversationConditionSuggestionsCommand}" Height="26" Width="80"/>
                                                </WrapPanel>

                                                <TextBlock Grid.Row="5" Grid.Column="0" Text="必要条件" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                <Grid Grid.Row="5" Grid.Column="1" Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Text="{Binding SelectedConversationEntry.Conditions.RequiredFlagIdsText, UpdateSourceTrigger=PropertyChanged}" ToolTip="必要フラグID（カンマまたは改行区切り）" Margin="0,0,4,0"/>
                                                    <TextBox Grid.Column="1" Text="{Binding SelectedConversationEntry.Conditions.RequiredSkillIdsText, UpdateSourceTrigger=PropertyChanged}" ToolTip="必要スキルID（カンマまたは改行区切り）" Margin="4,0,0,0"/>
                                                </Grid>

                                                    </Grid>
                                                </Expander>

                                                <Expander Header="画像・演出"
                                                          IsExpanded="False"
                                                          Margin="0,0,0,8">
                                                    <Grid Margin="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="画像AssetId" VerticalAlignment="Top" Margin="0,4,8,8"/>
                                                <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="80"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Text="{Binding SelectedConversationEntry.ImageAssetIdsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="64" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AcceptedAssets}" SelectedItem="{Binding SelectedConversationImageAsset}" DisplayMemberPath="AssetId" Height="26" Margin="0,0,8,0"/>
                                                    <Button Grid.Column="2" Content="追加" Command="{Binding AddConversationImageAssetCommand}" Height="26" VerticalAlignment="Top"/>
                                                </Grid>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="優先度・Ending" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                <WrapPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                                                    <TextBox Text="{Binding SelectedConversationEntry.Priority, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                                    <StackPanel Orientation="Horizontal" Margin="24,0,0,0" Visibility="{Binding SelectedConversationEntry.IsEnding, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="Ending表示" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <ComboBox ItemsSource="{Binding EndingVisualModeOptions}" SelectedItem="{Binding SelectedConversationEntry.EndingVisualMode, UpdateSourceTrigger=PropertyChanged}" Width="150" ToolTip="Auto: 従来表示、StillOnly: スチルのみ、StillWithPortrait: スチルと立ち絵、PortraitOnly: 立ち絵のみ"/>
                                                        <CheckBox Content="代表スチルを全ページで維持" IsChecked="{Binding SelectedConversationEntry.KeepEndingStillAcrossPages, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                                    </StackPanel>
                                                </WrapPanel>

                                                    </Grid>
                                                </Expander>

                                                <Expander Header="メモ"
                                                          IsExpanded="False">
                                                    <StackPanel Margin="8">
                                                        <TextBlock Text="会話項目に関する補足情報" Foreground="Gray" Margin="0,0,0,6"/>
                                                        <TextBox Text="{Binding SelectedConversationEntry.Memo, UpdateSourceTrigger=PropertyChanged}"
                                                                 AcceptsReturn="True"
                                                                 MinHeight="100"
                                                                 TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Expander>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>
                                </TabControl>
                            </Grid>

                            <Button Grid.Row="2"
                                    Content="会話データ保存"
                                    Command="{Binding SaveConversationDataCommand}"
                                    Width="140"
                                    Height="30"
                                    HorizontalAlignment="Right"
                                    Margin="0,12,0,0"/>
                        </Grid>
                    </TabItem>

                    <TabItem Header="戦闘メッセージ">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="戦闘後イベント（結果種別、戦闘Context、本文、スチル、好感度、解放衣装）"
                                       FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedProfile.BattleMessages.ResultEvents}"
                                      SelectedItem="{Binding SelectedBattleResultEvent}"
                                      AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True"
                                      Margin="0,0,0,12">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="EventId" Binding="{Binding EventId}" Width="130"/>
                                    <DataGridTemplateColumn Header="結果種別" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding Data.BattleResultTypeOptions, Source={StaticResource ViewModelProxy}}"
                                                          SelectedItem="{Binding ResultType, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="BattleContextId" Binding="{Binding BattleContextId}" Width="130"/>
                                    <DataGridTemplateColumn Header="話者種別" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding Data.BattleSpeakerTypeOptions, Source={StaticResource ViewModelProxy}}"
                                                          SelectedItem="{Binding SpeakerType, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="話者名" Binding="{Binding SpeakerName}" Width="120"/>
                                    <DataGridTextColumn Header="メッセージ" Binding="{Binding Message}" Width="*"/>
                                    <DataGridTemplateColumn Header="Voice ID" Width="190">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding Data.AvailableVoiceIds, Source={StaticResource ViewModelProxy}}"
                                                          Text="{Binding VoiceId, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEditable="True"
                                                          ToolTip="音声タブで検出したIDから選択。直接入力も可能です"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="StillId" Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding Data.BattleStillIdOptions, Source={StaticResource ViewModelProxy}}"
                                                          Text="{Binding StillId, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEditable="True"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="表示方式" Width="145">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding Data.BattleVisualModeOptions, Source={StaticResource ViewModelProxy}}"
                                                          SelectedItem="{Binding VisualMode, UpdateSourceTrigger=PropertyChanged}"
                                                          ToolTip="Auto: スチル優先／未解決時は暗幕+立ち絵、StillOnly: スチルのみ、StillWithPortrait: 暗幕+スチル+立ち絵、PortraitOnly: 暗幕+立ち絵"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="表情" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding Data.ExpressionIdOptions, Source={StaticResource ViewModelProxy}}"
                                                          Text="{Binding ExpressionId, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEditable="True"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="好感度" Binding="{Binding AffectionChange}" Width="65"/>
                                    <DataGridTemplateColumn Header="解放OutfitId（カンマ区切り）" Width="210">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding Data.CostumeIdOptions, Source={StaticResource ViewModelProxy}}"
                                                          Text="{Binding UnlockedOutfitIdsText, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEditable="True" ToolTip="候補を1件選択、または複数IDをカンマ区切りで入力"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Grid.Row="2" Text="戦闘パネル結果メッセージ" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <DataGrid Grid.Row="3" ItemsSource="{Binding SelectedProfile.BattleMessages.PanelMessages}"
                                      SelectedItem="{Binding SelectedBattlePanelMessage}"
                                      AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="MessageId" Binding="{Binding MessageId}" Width="130"/>
                                    <DataGridTemplateColumn Header="結果種別" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding Data.BattlePanelResultTypeOptions, Source={StaticResource ViewModelProxy}}"
                                                          SelectedItem="{Binding ResultType, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="メッセージ" Binding="{Binding Message}" Width="*"/>
                                    <DataGridTemplateColumn Header="Voice ID" Width="190">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding Data.AvailableVoiceIds, Source={StaticResource ViewModelProxy}}"
                                                          Text="{Binding VoiceId, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEditable="True"
                                                          ToolTip="音声タブで検出したIDから選択。直接入力も可能です"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Grid.Row="4" Text="主人公単独外出後の帰還反応（未設定ならゲームでは何も追加しません）"
                                       FontWeight="SemiBold" Margin="0,12,0,6"/>
                            <DataGrid Grid.Row="5" ItemsSource="{Binding SelectedProfile.BattleMessages.SoloReturnReactions}"
                                      AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ReactionId" Binding="{Binding ReactionId}" Width="130"/>
                                    <DataGridTemplateColumn Header="結果種別" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding Data.SoloReturnResultTypeOptions, Source={StaticResource ViewModelProxy}}"
                                                          SelectedItem="{Binding ResultType, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="BattleContextId" Binding="{Binding BattleContextId}" Width="130"/>
                                    <DataGridTextColumn Header="メッセージ" Binding="{Binding Message}" Width="*"/>
                                    <DataGridTemplateColumn Header="Voice ID" Width="180">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                            <ComboBox ItemsSource="{Binding Data.AvailableVoiceIds, Source={StaticResource ViewModelProxy}}"
                                                      Text="{Binding VoiceId, UpdateSourceTrigger=PropertyChanged}" IsEditable="True"/>
                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="StillId" Width="130">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                            <ComboBox ItemsSource="{Binding Data.BattleStillIdOptions, Source={StaticResource ViewModelProxy}}"
                                                      Text="{Binding StillId, UpdateSourceTrigger=PropertyChanged}" IsEditable="True"/>
                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="表示方式" Width="140">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                            <ComboBox ItemsSource="{Binding Data.BattleVisualModeOptions, Source={StaticResource ViewModelProxy}}"
                                                      SelectedItem="{Binding VisualMode, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="表情" Width="120">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                            <ComboBox ItemsSource="{Binding Data.ExpressionIdOptions, Source={StaticResource ViewModelProxy}}"
                                                      Text="{Binding ExpressionId, UpdateSourceTrigger=PropertyChanged}" IsEditable="True"/>
                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Grid Grid.Row="6" Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="1" Padding="8">
                                    <TextBlock Text="{Binding LastBattleMessageImportReport}"
                                               TextWrapping="Wrap"/>
                                </Border>
                                <Button Grid.Row="1" Content="戦闘メッセージ保存"
                                        Command="{Binding SaveSelectedProfileCommand}" Width="160" Height="30"
                                        HorizontalAlignment="Right" Margin="0,8,0,0"/>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="画像制作">
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="430"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="1" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="頭パーツ制作" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="1"
                                               Text="パーツを選び、透過PNGを指定して採用します。内部ID・描画順・Accepted状態は自動設定されます。"
                                               Foreground="Gray" TextWrapping="Wrap" Margin="0,6,0,14"/>

                                    <ListBox Grid.Row="2" ItemsSource="{Binding HeadPartWorkspaceItems}"
                                             SelectedItem="{Binding SelectedHeadPartWorkspaceItem}"
                                             Height="126" Margin="0,0,0,14">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Description}" Foreground="Gray" FontSize="11"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Margin="12,0,4,0" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <TextBlock Grid.Row="3" Text="表情の種類" FontWeight="SemiBold"/>
                                    <ComboBox Grid.Row="4"
                                              ItemsSource="{Binding ExpressionIdOptions}"
                                              Text="{Binding SelectedHeadPartWorkspaceItem.ExpressionId, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True"
                                              IsEnabled="{Binding SelectedHeadPartWorkspaceItem.IsExpression}"
                                              ToolTip="表情を選択した場合に Neutral、Smile、Angry などを入力します"
                                              Margin="0,6,0,12"/>

                                    <TextBlock Grid.Row="5" Text="登録する透過PNG" FontWeight="SemiBold"/>
                                    <Grid Grid.Row="6" Margin="0,6,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="82"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding SelectedHeadPartWorkspaceItem.SourceImagePath, UpdateSourceTrigger=PropertyChanged}"
                                                 AllowDrop="True"
                                                 PreviewDragOver="ImageSourcePath_PreviewDragOver"
                                                 Drop="HeadPartImagePath_Drop"
                                                 Margin="0,0,8,0"/>
                                        <Button Grid.Column="1" Content="参照" Command="{Binding BrowseHeadPartImageCommand}"/>
                                    </Grid>

                                    <Grid Grid.Row="7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="レイヤープレビューでテスト"
                                                Command="{Binding TestHeadPartPreviewCommand}"
                                                Height="36"/>
                                        <Button Grid.Column="2" Content="登録して採用"
                                                Command="{Binding AdoptHeadPartImageCommand}"
                                                Height="36" FontWeight="SemiBold"/>
                                    </Grid>
                                    <TextBlock Grid.Row="8" Text="{Binding HeadPartWorkspaceMessage}"
                                               Foreground="Gray" TextWrapping="Wrap" Margin="0,10,0,10"/>

                                    <Expander Grid.Row="9" Header="自動設定される詳細" VerticalAlignment="Top">
                                        <StackPanel Margin="8">
                                            <TextBlock Text="{Binding SelectedHeadPartWorkspaceItem.AssetId, StringFormat=AssetId: {0}}"/>
                                            <TextBlock Text="{Binding SelectedHeadPartWorkspaceItem.LayerKind, StringFormat=LayerKind: {0}}"/>
                                            <TextBlock Text="{Binding SelectedHeadPartWorkspaceItem.DrawOrder, StringFormat=DrawOrder: {0}}"/>
                                        </StackPanel>
                                    </Expander>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" BorderBrush="#DDDDDD" BorderThickness="1" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="150"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="頭パーツ合成プレビュー" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <Grid Grid.Row="1" Background="#F7F7F7">
                                        <ItemsControl ItemsSource="{Binding HeadPartPreviewItems}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Grid/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Image Source="{Binding ImagePath, Converter={StaticResource StringToImageSourceConverter}}" Stretch="Uniform"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                    <DataGrid Grid.Row="2" ItemsSource="{Binding HeadPartPreviewItems}"
                                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="0,10,0,0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="順" Binding="{Binding DrawOrder}" Width="55"/>
                                            <DataGridTextColumn Header="パーツ" Binding="{Binding DisplayName}" Width="150"/>
                                            <DataGridTextColumn Header="AssetId" Binding="{Binding AssetId}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="画像（詳細）">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="96"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="AssetId" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding AssetIdInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="元画像" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="1"
                                         Grid.Column="1"
                                         Text="{Binding ImageSourcePathInput, UpdateSourceTrigger=PropertyChanged}"
                                         AllowDrop="True"
                                         PreviewDragOver="ImageSourcePath_PreviewDragOver"
                                         Drop="ImageSourcePath_Drop"
                                         Margin="0,0,8,8"/>
                                <Button Grid.Row="1" Grid.Column="2" Content="参照" Command="{Binding BrowseImageCommand}" Height="26" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="用途" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding AssetUsages}" SelectedItem="{Binding SelectedAssetUsage}" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="状態" VerticalAlignment="Center"/>
                                <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding AssetStatuses}" SelectedItem="{Binding SelectedAssetStatus}" Margin="0,0,8,0"/>
                                <Button Grid.Row="3" Grid.Column="2" Content="画像登録" Command="{Binding AddImageAssetCommand}" Height="26"/>
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="登録済み画像" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Content="戦闘候補追加"
                                            Command="{Binding AddHeroineBattleStandardAssetDataCommand}"
                                            Height="24"
                                            Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="2" Text="Status" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox Grid.Column="3"
                                              ItemsSource="{Binding AssetStatusFilters}"
                                              SelectedItem="{Binding SelectedAssetStatusFilter}"
                                              Height="24"/>
                                </Grid>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="プレビュー" FontWeight="SemiBold" Margin="0,0,0,8"/>

                                <DataGrid Grid.Row="1"
                                          Grid.Column="0"
                                          ItemsSource="{Binding FilteredAssets}"
                                          SelectedItem="{Binding SelectedAsset}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="AssetId" Binding="{Binding AssetId}" Width="140" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="用途" Binding="{Binding Usage}" Width="90" IsReadOnly="True"/>
                                        <DataGridComboBoxColumn Header="状態"
                                                                SelectedItemBinding="{Binding Status}"
                                                                ItemsSource="{Binding Data.AssetStatuses, Source={StaticResource ViewModelProxy}}"
                                                                Width="100"/>
                                        <DataGridTextColumn Header="ファイル名" Binding="{Binding FileName}" Width="160" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="保存先" Binding="{Binding StoredPath}" Width="*" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel Grid.Row="2"
                                            Grid.Column="0"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,8,0,0">
                                    <Button Content="登録解除"
                                            Command="{Binding UnregisterImageAssetCommand}"
                                            Width="100"
                                            Height="28"
                                            Margin="0,0,8,0"/>
                                    <Button Content="画像情報保存"
                                            Command="{Binding SaveImageAssetsCommand}"
                                            Width="140"
                                            Height="28"/>
                                </StackPanel>

                                <Border Grid.Row="1"
                                        Grid.Column="2"
                                        BorderBrush="#DDDDDD"
                                        BorderThickness="1"
                                        Padding="8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Image Grid.Row="0"
                                               Source="{Binding SelectedAssetImagePath, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                               Stretch="Uniform"/>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding SelectedAssetImageMessage}"
                                                   Foreground="Gray"
                                                   TextWrapping="Wrap"
                                                   Margin="0,8,0,0"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="訓練画像">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="訓練条件、画像マッピング、画像作成・採用を用途別のページで編集します。Unity読込と保存は各ページで共通です。"
                                           Foreground="Gray" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Unity訓練一覧読込"
                                            Command="{Binding ImportTrainingCatalogFromUnityCommand}"
                                            MinWidth="150" Height="28" Margin="0,0,8,0"/>
                                    <Button Content="Unity訓練セリフ読込"
                                            Command="{Binding ImportTrainingDialoguesFromUnityCommand}"
                                            MinWidth="160" Height="28"/>
                                </StackPanel>
                            </Grid>

                            <TabControl Grid.Row="1" Grid.RowSpan="2" Margin="0,0,0,12">
                                <TabItem Header="訓練条件">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                                        <StackPanel>
                                    <GroupBox Header="Unityから取り込んだ訓練一覧" Margin="0,8,0,8">
                                        <DataGrid ItemsSource="{Binding SelectedProfile.TrainingCatalog.Items}"
                                                  SelectedItem="{Binding SelectedTrainingCatalogItem}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  IsReadOnly="True"
                                                  RowDetailsVisibilityMode="VisibleWhenSelected"
                                                  Height="220"
                                                  Margin="8">
                                            <DataGrid.RowDetailsTemplate>
                                                <DataTemplate>
                                                    <Border Background="#FFF6F6F6" Padding="8" Margin="4">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding ConditionDetails}"
                                                                       TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding ReferenceWarning}"
                                                                       Foreground="DarkOrange"
                                                                       FontWeight="Bold"
                                                                       Margin="0,4,0,0"
                                                                       TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGrid.RowDetailsTemplate>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="TrainingId" Binding="{Binding TrainingId}" Width="180"/>
                                                <DataGridTextColumn Header="表示名" Binding="{Binding DisplayName}" Width="140"/>
                                                <DataGridTextColumn Header="カテゴリー" Binding="{Binding TrainingCategoryId}" Width="130"/>
                                                <DataGridTextColumn Header="解放" Binding="{Binding UnlockSummary}" Width="150"/>
                                                <DataGridTextColumn Header="条件" Binding="{Binding ConditionBadgeSummary}" Width="220"/>
                                                <DataGridTextColumn Header="前提" Binding="{Binding PrerequisiteSummary}" Width="180"/>
                                                <DataGridTextColumn Header="警告" Binding="{Binding ReferenceWarning}" Width="180"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </GroupBox>
                                    <GroupBox Header="選択中の訓練条件を編集" Margin="0,0,0,8">
                                        <Grid Margin="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="出現回数" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Row="0" Grid.Column="1"
                                                      SelectedValue="{Binding SelectedTrainingCatalogItem.OccurrenceType, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectedValuePath="Tag" Margin="0,0,12,6">
                                                <ComboBoxItem Content="反復可能" Tag="Repeatable"/>
                                                <ComboBoxItem Content="セーブデータにつき一回" Tag="OncePerSave"/>
                                            </ComboBox>
                                            <CheckBox Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2"
                                                      Content="初期解放"
                                                      IsChecked="{Binding SelectedTrainingCatalogItem.UnlockedByDefault, UpdateSourceTrigger=PropertyChanged}"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="表示できる調子" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                                     Text="{Binding SelectedTrainingCatalogItem.VisibleConditionRanksText, UpdateSourceTrigger=LostFocus}"
                                                     Margin="0,0,0,6"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="実行できる調子" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                                                     Text="{Binding SelectedTrainingCatalogItem.ExecutableConditionRanksText, UpdateSourceTrigger=LostFocus}"
                                                     Margin="0,0,0,6"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                                                       Text="候補: Excellent, Good, Normal, Poor, Awful。空欄ならすべての調子。"
                                                       Foreground="Gray" Margin="0,0,0,6"/>

                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="前提TrainingId" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,12,6">
                                                <TextBox Text="{Binding SelectedTrainingCatalogItem.RequiredCompletedTrainingIdsText, UpdateSourceTrigger=LostFocus}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <ComboBox ItemsSource="{Binding SelectedProfile.TrainingCatalog.Items}"
                                                              DisplayMemberPath="TrainingId" SelectedValuePath="TrainingId"
                                                              SelectedValue="{Binding SelectedTrainingPrerequisiteCandidate}"
                                                              Width="170"/>
                                                    <Button Content="追加" Command="{Binding AddTrainingPrerequisiteCommand}" Margin="4,0,0,0"/>
                                                    <Button Content="全解除" Command="{Binding ClearTrainingPrerequisitesCommand}" Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <CheckBox Grid.Row="4" Grid.Column="2" Content="すべて必要"
                                                      IsChecked="{Binding SelectedTrainingCatalogItem.RequireAllCompletedTrainings, UpdateSourceTrigger=PropertyChanged}"/>
                                            <CheckBox Grid.Row="4" Grid.Column="3" Content="前提未達時は隠す"
                                                      IsChecked="{Binding SelectedTrainingCatalogItem.HideUntilPrerequisitesMet, UpdateSourceTrigger=PropertyChanged}"/>

                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="解放NodeId" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,0,12,6">
                                                <TextBox Text="{Binding SelectedTrainingCatalogItem.UnlockNodeIdsText, UpdateSourceTrigger=LostFocus}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <ComboBox ItemsSource="{Binding SelectedProfile.HeroineSkillTree.Nodes}"
                                                              DisplayMemberPath="NodeId" SelectedValuePath="NodeId"
                                                              SelectedValue="{Binding SelectedTrainingUnlockNodeCandidate}"
                                                              Width="170"/>
                                                    <Button Content="追加" Command="{Binding AddTrainingUnlockNodeCommand}" Margin="4,0,0,0"/>
                                                    <Button Content="全解除" Command="{Binding ClearTrainingUnlockNodesCommand}" Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <CheckBox Grid.Row="5" Grid.Column="2" Grid.ColumnSpan="2" Content="完了後は隠す"
                                                      IsChecked="{Binding SelectedTrainingCatalogItem.HideAfterCompletion, UpdateSourceTrigger=PropertyChanged}"/>

                                            <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="4">
                                                <TextBlock Text="{Binding TrainingIdSuggestions, StringFormat=登録済み訓練: {0}}" Foreground="Gray" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding TrainingUnlockNodeSuggestions, StringFormat=登録済み解放ノード: {0}}" Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,6"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="条件を検証して保存" Command="{Binding SaveSelectedProfileCommand}" MinWidth="150" Height="28"/>
                                                    <TextBlock Text="保存後にExportし、Unityの Heroine Export Import で反映します。共通TrainingDataの条件は全ヒロインに影響します。"
                                                               Foreground="#A06000" TextWrapping="Wrap" Margin="12,5,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </GroupBox>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>

                                <TabItem Header="画像マッピング">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                                        <StackPanel>
                                    <TextBlock Text="空欄のマッピングは共通画像、または現在表示中の画像へフォールバックします。必要な場合だけ編集してください。"
                                               Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <GroupBox Header="訓練共通画像 AssetId" Margin="0,0,0,8">
                                        <Grid Margin="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="初回前" Margin="0,4,8,8"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedProfile.TrainingImages.Defaults.BeforeFirstStepImageAssetId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,8"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="実行後" Margin="0,4,8,8"/>
                                            <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding SelectedProfile.TrainingImages.Defaults.AfterFirstStepImageAssetId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="主人公LP消費" Margin="0,4,8,8"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedProfile.TrainingImages.Defaults.PlayerLpConsumedImageAssetId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,8"/>
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="ヒロインLP消費" Margin="0,4,8,8"/>
                                            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding SelectedProfile.TrainingImages.Defaults.HeroineLpConsumedImageAssetId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="同時LP消費" Margin="0,4,8,0"/>
                                            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding SelectedProfile.TrainingImages.Defaults.SimultaneousLpConsumedImageAssetId, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>
                                    </GroupBox>
                                    <DataGrid ItemsSource="{Binding SelectedProfile.TrainingImages.Items}"
                                              SelectedItem="{Binding SelectedTrainingImageEntry}"
                                              AutoGenerateColumns="False" CanUserAddRows="False" Height="180">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="TrainingId" Binding="{Binding TrainingId, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                                            <DataGridTextColumn Header="初回前 AssetId" Binding="{Binding BeforeFirstStepImageAssetId, UpdateSourceTrigger=PropertyChanged}" Width="190"/>
                                            <DataGridTextColumn Header="実行後 AssetId" Binding="{Binding AfterFirstStepImageAssetId, UpdateSourceTrigger=PropertyChanged}" Width="190"/>
                                            <DataGridTextColumn Header="主人公LP AssetId" Binding="{Binding PlayerLpConsumedImageAssetId, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                                            <DataGridTextColumn Header="ヒロインLP AssetId" Binding="{Binding HeroineLpConsumedImageAssetId, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                                            <DataGridTextColumn Header="同時LP AssetId" Binding="{Binding SimultaneousLpConsumedImageAssetId, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                                            <DataGridTextColumn Header="メモ" Binding="{Binding Memo, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0">
                                        <Button Content="訓練追加"
                                                Command="{Binding AddTrainingImageEntryCommand}"
                                                Width="90" Height="30" Margin="0,0,8,0"/>
                                        <Button Content="訓練削除"
                                                Command="{Binding RemoveTrainingImageEntryCommand}"
                                                Width="90" Height="30"/>
                                    </WrapPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>

                                <TabItem Header="画像作成・採用">
                                    <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="300"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="360"/>
                                </Grid.ColumnDefinitions>

                                <GroupBox Grid.Column="0" Header="1. 作成する訓練画像">
                                    <DataGrid ItemsSource="{Binding TrainingAssets}"
                                              SelectedItem="{Binding SelectedTrainingAsset}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="True"
                                              Margin="8">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="AssetId" Binding="{Binding AssetId}" Width="*"/>
                                            <DataGridTextColumn Header="状態" Binding="{Binding Status}" Width="80"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </GroupBox>

                                <GroupBox Grid.Column="2" Header="2. Promptと生成">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedTrainingAsset.AssetId, StringFormat=AssetId: {0}}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding CurrentPromptRecord.TrainingId, StringFormat=TrainingId: {0}}" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding CurrentPromptRecord.TrainingVisualState, StringFormat=表示状態: {0}}" Margin="0,4,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,8">
                                                <CheckBox Content="主人公を表示" IsChecked="{Binding CurrentPromptRecord.PlayerVisible}" Margin="0,0,16,0"/>
                                                <CheckBox Content="ヒロインを表示" IsChecked="{Binding CurrentPromptRecord.HeroineVisible}"/>
                                            </StackPanel>
                                            <GroupBox Header="ヒロインセリフ候補" Margin="0,0,0,8">
                                                <StackPanel Margin="8">
                                                    <ListBox ItemsSource="{Binding SelectedTrainingDialogueEntry.Messages}"
                                                             SelectedItem="{Binding SelectedTrainingDialogueMessage}"
                                                             DisplayMemberPath="Text"
                                                             Height="72"/>
                                                    <TextBox Text="{Binding SelectedTrainingDialogueMessage.Text, UpdateSourceTrigger=PropertyChanged}"
                                                             AcceptsReturn="True" TextWrapping="Wrap" Height="56" Margin="0,6,0,6"/>
                                                    <TextBlock Text="Voice ID（拡張子なし）"/>
                                                    <ComboBox ItemsSource="{Binding AvailableVoiceIds}"
                                                              Text="{Binding SelectedTrainingDialogueMessage.VoiceId, UpdateSourceTrigger=PropertyChanged}"
                                                              IsEditable="True"
                                                              ToolTip="音声タブで検出したIDから選択。直接入力も可能です"
                                                              Margin="0,4,0,6"/>
                                                    <WrapPanel HorizontalAlignment="Right">
                                                        <Button Content="候補追加" Command="{Binding AddTrainingDialogueMessageCommand}" Width="84" Margin="0,0,6,0"/>
                                                        <Button Content="候補削除" Command="{Binding RemoveTrainingDialogueMessageCommand}" Width="84"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </GroupBox>
                                            <TextBlock Text="positive prompt"/>
                                            <TextBox Text="{Binding CurrentPromptRecord.PositivePrompt, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True" TextWrapping="Wrap" Height="110" Margin="0,4,0,8"/>
                                            <TextBlock Text="negative prompt"/>
                                            <TextBox Text="{Binding CurrentPromptRecord.NegativePrompt, UpdateSourceTrigger=PropertyChanged}"
