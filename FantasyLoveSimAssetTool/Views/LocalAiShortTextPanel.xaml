<UserControl x:Class="FantasyLoveSimAssetTool.Views.LocalAiShortTextPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Border Background="#F4EFF6" BorderBrush="#B99AC4" BorderThickness="1"
            CornerRadius="7" Padding="14" Margin="0,2,0,14">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="AI文章候補" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Text="対象を選んで3案を生成します。採用するまで現在値は変わりません。"
                               Foreground="#66606A" TextWrapping="Wrap" Margin="0,3,12,0"/>
                </StackPanel>
                <WrapPanel Grid.Column="1">
                    <Button Content="3案を生成 / 再生成"
                            Command="{Binding GenerateShortTextCandidatesCommand}"
                            Padding="12,6" Margin="0,0,6,0"/>
                    <Button Content="不足分を再生成"
                            Command="{Binding GenerateMissingShortTextCandidatesCommand}"
                            Padding="12,6" Margin="0,0,6,0"/>
                    <Button Content="キャンセル"
                            Command="{Binding CancelShortTextGenerationCommand}"
                            Padding="12,6"/>
                </WrapPanel>
            </Grid>
            <Grid Margin="0,12,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="生成対象" VerticalAlignment="Center"/>
                <ComboBox x:Name="TargetComboBox" Grid.Column="1"
                          SelectedItem="{Binding SelectedShortTextTarget}"
                          DisplayMemberPath="DisplayName" Margin="0,0,14,0"/>
                <TextBlock Grid.Column="2" Text="現在値" VerticalAlignment="Center"/>
                <TextBox Grid.Column="3" Text="{Binding CurrentShortTextValue, Mode=OneWay}"
                         IsReadOnly="True" TextWrapping="Wrap" MinHeight="38"/>
            </Grid>
            <TextBlock Text="{Binding CurrentShortTextContext, Mode=OneWay}"
                       Foreground="#66606A" Margin="0,0,0,8" TextWrapping="Wrap"/>
            <TextBox Text="{Binding ShortTextAiStatus, Mode=OneWay}"
                     IsReadOnly="True" TextWrapping="Wrap" MinHeight="36"
                     Margin="0,0,0,8"/>
            <ItemsControl ItemsSource="{Binding ShortTextCandidates}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True"
                                     TextWrapping="Wrap" MinHeight="38" Margin="0,0,8,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="{Binding CharacterCount, StringFormat={}{0}文字}"/>
                                <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#39734B"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                                    <Setter Property="Foreground" Value="#9A5B28"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <CheckBox IsChecked="{Binding UseExpressionSuggestion}"
                                          Visibility="{Binding HasExpressionSuggestion, Converter={StaticResource BooleanToVisibilityConverter}}"
                                          Margin="0,4,0,0">
                                    <TextBlock Text="{Binding ExpressionId, StringFormat=表情も反映: {0}}"/>
                                </CheckBox>
                            </StackPanel>
                            <Button Grid.Column="2" Content="この案を採用" Padding="12,6"
                                    Command="{Binding DataContext.AdoptShortTextCandidateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Expander Header="送信プロンプト・生レスポンス" Margin="0,8,0,0">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBox Text="{Binding ShortTextAiPrompt, Mode=OneWay}" IsReadOnly="True"
                             AcceptsReturn="True" Height="130" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>
                    <TextBox Grid.Row="1" Text="{Binding ShortTextAiRawResponse, Mode=OneWay}" IsReadOnly="True"
                             AcceptsReturn="True" Height="110" FontFamily="Consolas" FontSize="11"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"/>
                </Grid>
            </Expander>
        </StackPanel>
    </Border>
</UserControl>
